{
	"name": "@kilo-desktop/plugin-environments",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "kilo.environments: conda environments and packages through the bundled conda bridge, for the person and the agent",
	"author": "Anaconda, Inc.",
	"license": "SEE LICENSE IN ../../LICENSE.md",
	"exports": {
		"./plugin.json": "./plugin.json",
		"./main": "./src/main/index.ts",
		"./web": "./src/web/index.ts",
		"./contracts": "./src/contracts/index.ts",
		"./packaging": "./src/packaging/index.ts"
	},
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"fetch-bridge": "node --env-file-if-exists=.env.local --import tsx scripts/fetch-bridge.ts",
		"prepare-assets": "pnpm run fetch-bridge"
	},
	"dependencies": {
		"@kilo-desktop/kernel": "workspace:*",
		"@kilo-desktop/plugin-chat": "workspace:*",
		"@kilo-desktop/plugin-core": "workspace:*",
