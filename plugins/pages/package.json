{
	"name": "@kilo-desktop/plugin-pages",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "kilo.pages: nteract Pages served on this device, in a work session's panes and to the agent",
	"author": "Anaconda, Inc.",
	"license": "SEE LICENSE IN ../../LICENSE.md",
	"exports": {
		"./plugin.json": "./plugin.json",
		"./main": "./src/main/index.ts",
		"./web": "./src/web/index.ts",
		"./contracts": "./src/contracts/index.ts"
	},
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
