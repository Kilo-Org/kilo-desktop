# Set up freshly created worktrees (Kilo Agent Manager, Kilo Desktop work sessions,
# `git worktree add`) in the background so creating the worktree returns at once.
# Progress and the agent wait protocol live in .kilo/worktree-setup/ (see AGENTS.md).
# git passes: $1 = previous HEAD, $2 = new HEAD, $3 = 1 for branch checkouts.
# A null previous HEAD (all zeros) means a new worktree; branch switches are skipped.
[ "$3" = "1" ] || exit 0
case "$1" in
	*[!0]*) exit 0 ;;
esac
[ -n "$CI" ] && exit 0

# The relative core.hooksPath resolves in the checkout that ran `git worktree add`,
# so take the script from beside this hook: the new worktree's commit may predate it.
setup="$(cd "$(dirname "$0")/.." && pwd)/scripts/setup-worktree.mjs"
cd "$(git rev-parse --show-toplevel)" || exit 0

if node "$setup" --background; then
	echo "post-checkout: installing dependencies in the background; log: .kilo/worktree-setup/log"
else
	echo "post-checkout: could not start worktree setup; run: node scripts/setup-worktree.mjs" >&2
fi
exit 0
