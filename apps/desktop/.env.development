# Public OAuth client ID for local development. OAuth client IDs are not secrets.
VITE_AUTH_CLIENT_ID=a2de2b01-8b4f-4134-b73d-981473d32f11
VITE_LAUNCHDARKLY_CLIENT_SIDE_ID=6a7b2d5393431f0a904f0261
# Sentry reporting is disabled for development. View them locally via
# Spotlight instead (see README "Local Sentry via Spotlight")
VITE_SENTRY_DSN=
# Bridge Sentry is disabled for development too (view locally via Spotlight).
VITE_BRIDGE_SENTRY_DSN=

# Telemetry (OTEL logging) — development. Stage endpoints; `development`
# env-attribute keeps events out of prod/test data.
VITE_ANACONDA_LOGGING_AUTH_URL='https://metrics.stage.internal.anacondaconnect.com/v1/logs'
VITE_ANACONDA_LOGGING_NON_AUTH_URL='https://metrics.stage.internal.anacondaconnect.com/v1/logs'
VITE_ANACONDA_LOGGING_EXPORT_INTERVAL_MS=3000
VITE_ANACONDA_LOGGING_ENV_ATTRIBUTE='development'
