		"friendly-words": "1.3.1",
		"lucide-react": "catalog:",
		"p-limit": "catalog:",
		"react-use": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"@kilo-desktop/feature-sdk": "workspace:*",
		"@kilo-desktop/sdk-react": "workspace:*",
		"@kilo-desktop/ui": "workspace:*",
		"@tanstack/react-query": "catalog:",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@kilo-desktop/e2e": "workspace:*",
		"@kilo-desktop/feature-sdk": "workspace:*",
		"@kilo-desktop/sdk-react": "workspace:*",
		"@kilo-desktop/testing": "workspace:*",
