{
	"name": "anaconda-agentic-desktop",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Anaconda Agentic Desktop",
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "turbo run check",
		"dev": "pnpm dev:desktop",
		"dev:web": "pnpm --filter @anaconda-agentic-desktop/web dev",
		"dev:desktop": "concurrently --kill-others --success first \"pnpm dev:web\" \"wait-on http://127.0.0.1:5173 && cross-env ANACONDA_WEB_DEV_SERVER_URL=http://127.0.0.1:5173 pnpm --filter @anaconda-agentic-desktop/desktop start\"",
		"format": "oxfmt --no-error-on-unmatched-pattern",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"make": "pnpm --filter @anaconda-agentic-desktop/desktop run make",
		"package": "pnpm --filter @anaconda-agentic-desktop/desktop run package",
		"package:e2e": "pnpm --filter @anaconda-agentic-desktop/desktop run package:e2e",
		"postinstall": "node -e \"try { if (process.platform !== 'win32') require('node:fs').chmodSync('node_modules/@electron-forge/cli/dist/electron-forge.js', 0o755) } catch (error) { if (error.code !== 'ENOENT') throw error }\"",
		"publish": "pnpm --filter @anaconda-agentic-desktop/desktop run publish",
		"start": "pnpm dev:desktop",
		"prepare": "husky",
		"test": "turbo run test",
		"test:web": "pnpm --filter @anaconda-agentic-desktop/web test",
		"test:desktop": "pnpm --filter @anaconda-agentic-desktop/desktop test",
		"test:contracts": "pnpm --filter @anaconda-agentic-desktop/contracts test",
		"test:e2e": "pnpm --filter @anaconda-agentic-desktop/e2e run test:e2e",
		"test:e2e:smoke": "pnpm --filter @anaconda-agentic-desktop/e2e run test:e2e:smoke",
		"coverage": "turbo run coverage"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,tsx}": [
			"npm run lint:fix",
			"npm run format"
		],
		"*.{json,md,yaml,yml,css}": [
			"npm run format"
		]
	},
	"devDependencies": {
		"@anaconda-agentic-desktop/feature-sdk": "workspace:*",
		"@anaconda-agentic-desktop/sdk-react": "workspace:*",
		"@anaconda-agentic-desktop/ui": "workspace:*",
		"@opencode-ai/sdk": "workspace:*",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "catalog:",
		"concurrently": "^10.0.0",
		"cross-env": "^10.1.0",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.76.0",
		"tsx": "^4.23.1",
		"turbo": "^2.10.11",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wait-on": "^9.0.3"
	}
}
