{
	"name": "@kilo-desktop/plugin-environments",
	"version": "0.1.1",
	"private": true,
	"type": "module",
	"description": "Environments plugin — provider-based env/package/source management. v1 ships a conda provider backed by a bundled cx runtime; future providers (uv, pip, …) plug into the same interface.",
	"exports": {
		"./plugin.json": "./plugin.json",
		"./main": "./src/main/index.ts",
		"./web": "./src/web/index.ts",
		"./capabilities": "./src/contracts/capabilities.ts",
		"./packaging": "./src/packaging/index.ts"
	},
	"scripts": {
		"build-mcp-app": "vite build --config src/mcp-app/vite.config.ts",
		"check": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"fetch-bridge": "node --env-file-if-exists=.env.local --import tsx scripts/fetch-bridge.ts",
		"prepare-assets": "pnpm run build-mcp-app && pnpm run fetch-bridge"
	},
	"dependencies": {
		"@kilo-desktop/feature-sdk": "workspace:*",
		"@kilo-desktop/sdk-react": "workspace:*",
		"@kilo-desktop/ui": "workspace:*",
		"@modelcontextprotocol/client": "^2.0.0",
		"@modelcontextprotocol/core": "^2.0.0",
		"@modelcontextprotocol/ext-apps": "^2.0.0",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-virtual": "^3.14.9",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"vscode-jsonrpc": "^9.0.1",
		"zod": "catalog:"
	},
	"optionalDependencies": {
		"@anaconda/desktop-bridge-payload-darwin-arm64": "0.1.16",
		"@anaconda/desktop-bridge-payload-linux-arm64": "0.1.16",
		"@anaconda/desktop-bridge-payload-linux-x64": "0.1.16",
		"@anaconda/desktop-bridge-payload-win32-arm64": "0.1.16",
		"@anaconda/desktop-bridge-payload-win32-x64": "0.1.16"
	},
	"devDependencies": {
		"@kilo-desktop/e2e": "workspace:*",
		"@kilo-desktop/testing": "workspace:*",
		"@anaconda/playwright-utils": "2.1.0",
		"@playwright/test": "catalog:",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"@vitest/browser": "5.0.3",
		"@vitest/browser-playwright": "5.0.3",
		"@vitest/coverage-v8": "catalog:",
		"playwright": "catalog:",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-singlefile": "^2.0.0",
		"vitest": "catalog:"
	}
}
