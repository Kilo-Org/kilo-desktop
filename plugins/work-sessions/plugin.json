					"title": "Go to tab 6",
					"category": "Tabs",
					"order": 6,
					"palette": false,
					"keybinding": "Mod+6",
					"when": {
						"all": ["kilo.work-sessions/workSessionActive"],
						"none": ["kernel/secondaryWindow"]
