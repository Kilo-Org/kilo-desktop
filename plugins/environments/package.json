		"@kilo-desktop/plugin-shell": "workspace:*",
		"@kilo-desktop/ui": "workspace:*",
		"@tanstack/react-query": "^5.108.0",
		"@tanstack/react-virtual": "^3.14.9",
		"lucide-react": "catalog:",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"systeminformation": "5.33.23",
		"vscode-jsonrpc": "^10.0.0",
		"zod": "catalog:"
	},
	"optionalDependencies": {
		"@anaconda/desktop-bridge-payload-darwin-arm64": "npmjs:0.1.22",
		"@anaconda/desktop-bridge-payload-linux-arm64": "npmjs:0.1.22",
		"@anaconda/desktop-bridge-payload-linux-x64": "npmjs:0.1.22",
		"@anaconda/desktop-bridge-payload-win32-arm64": "npmjs:0.1.22",
		"@anaconda/desktop-bridge-payload-win32-x64": "npmjs:0.1.22"
	},
