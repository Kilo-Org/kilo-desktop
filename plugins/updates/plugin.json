{
	"manifestVersion": 1,
	"id": "kilo.updates",
	"displayName": "Updates",
	"version": "1.0.0",
	"description": "App updates: the version, update and legal blocks of About, release notes and the update-ready notice.",
	"requires": {
		"kilo.shell/about-section": "optional",
		"kilo.shell/left-sidebar-notice": "optional"
	},
	"permissions": {
		"host": ["updater", "os"]
	},
	"domains": [
		{
			"id": "legal",
			"home": "main",
			"description": "The third-party notices shipped beside the app, shown in About \u2192 Legal."
		}
	],
	"contributes": {
		"extensions": {
			"kilo.shell/about-section": [
				{
					"id": "version",
					"priority": 300
				},
				{
					"id": "legal",
					"priority": 100
				}
			],
			"kilo.shell/left-sidebar-notice": [
				{
					"id": "update-ready"
				}
			]
		}
	}
}
