# Public OAuth client ID for local development. OAuth client IDs are not secrets.
VITE_AUTH_CLIENT_ID=a2de2b01-8b4f-4134-b73d-981473d32f11
VITE_LAUNCHDARKLY_CLIENT_SIDE_ID=6a7b2d5393431f0a904f0261
# Sentry reporting is disabled for development. View them locally via
# Spotlight instead (see README "Local Sentry via Spotlight")
VITE_SENTRY_DSN=

# Telemetry (OTEL logging). Empty URLs make the provider fall back to
# localhost:4318, so local/dev builds never send to prod. `test` env-attribute
# keeps local events out of real prod/staging data.
VITE_ANACONDA_LOGGING_AUTH_URL=''
VITE_ANACONDA_LOGGING_NON_AUTH_URL=''
VITE_ANACONDA_LOGGING_EXPORT_INTERVAL_MS=3000
VITE_ANACONDA_LOGGING_ENV_ATTRIBUTE='test'
