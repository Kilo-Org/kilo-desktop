{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node", "vitest/globals"],
		"paths": {
			"$config/*": ["./config/*"],
			"@runtimed/node/electron": ["../../plugins/notebook/types/runtimed-node/electron.ts"],
			"@runtimed/node/relay": ["../../plugins/notebook/types/runtimed-node/relay.ts"]
		}
	},
	"include": [
		"config/**/*.ts",
		"src/**/*.ts",
		"forge.config.ts",
		"vite.main.config.ts",
		"vite.preload.config.ts",
		"vitest.config.ts"
	]
}
