		"@anaconda-agentic-desktop/plugin-kilo-ui": "link:../../plugins/kilo-ui",
		"@anaconda-agentic-desktop/plugin-todos": "workspace:*",
		"@anaconda-agentic-desktop/sdk-react": "workspace:*",
		"@anaconda-agentic-desktop/ui": "workspace:*",
		"@anaconda/shadcn-theme": "0.0.1-alpha.3",
		"@fontsource-variable/inter": "^5.3.0",
		"@mcp-b/webmcp-polyfill": "4.0.0",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.18",
		"lucide-react": "^1.27.0",
		"motion": "^12.43.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-use": "^17.6.1",
		"tw-shimmer": "^0.4.12",
		"zod": "catalog:"
