{
	"id": "browser",
	"displayName": "Browser",
	"version": "1.0.0",
	"main": "./src/main/index.ts",
	"web": "./src/web/index.ts",
	"contributes": {
		"providers": [],
		"routes": [],
		"nav": [],
		"zones": [
			{
				"zone": "kilo-ui/chat-markdown-extension",
				"id": "web-links",
				"component": "BrowserMarkdownExtension",
				"label": "Web links in a Browser tab",
				"description": "Open web links from chat messages in a Browser tab of the session.",
				"priority": 50
			},
			{
				"zone": "kilo-ui/chat-right-panel-tab",
				"id": "browser",
				"component": "BrowserView",
				"label": "Browser",
				"description": "Browse the web alongside this session.",
				"icon": "BrowserIcon",
				"mountPolicy": "keep-alive",
				"priority": 40
			}
		]
	}
}
