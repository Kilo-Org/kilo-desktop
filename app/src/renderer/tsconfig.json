{
	"extends": "../../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"noEmit": true,
		"paths": {
			"@/*": ["./*"],
			"$shared": ["../shared/index.ts"],
			"$shared/*": ["../shared/*"]
		},
		"types": ["vite/client", "vitest/globals"]
	},
	"include": ["./**/*.ts", "./**/*.tsx"]
}
