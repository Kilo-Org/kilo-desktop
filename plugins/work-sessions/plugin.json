					"category": "Sessions",
					"order": 6,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+6",
						"default": "Alt+6"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "work-session-7",
					"title": "Go to session 7",
					"category": "Sessions",
					"order": 7,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+7",
						"default": "Alt+7"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "work-session-8",
					"title": "Go to session 8",
					"category": "Sessions",
					"order": 8,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+8",
						"default": "Alt+8"
					},
					"when": {
