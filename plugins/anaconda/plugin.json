{
	"manifestVersion": 1,
	"id": "kilo.anaconda",
	"displayName": "Anaconda Account",
	"version": "1.0.0",
	"description": "Sign in to Anaconda to store the API key Anaconda services, like the model catalog, use.",
	"main": "./src/main/index.ts",
	"web": "./src/web/index.ts",
	"requires": {
		"kilo.shell/account-panel": "optional",
		"kilo.local-inference/model-catalog": "optional"
	},
	"permissions": {
		"host": ["os", "windows"]
	},
	"contextKeys": [
		{
			"id": "anacondaSignedIn",
			"scope": "global",
			"description": "True while an Anaconda account is signed in (once its session has been resolved)."
		}
	],
	"domainObjects": [
		{
			"id": "account",
			"home": "main",
			"description": "The Anaconda account: its session, the browser sign-in and the stored API key."
		}
	],
	"contributes": {
		"extensions": {
			"kernel/linked-account": [
				{
					"id": "anaconda"
				}
			],
			"kilo.local-inference/model-catalog": [
				{
					"id": "anaconda-models",
					"title": "Anaconda"
				}
			],
			"kilo.shell/account-panel": [
				{
					"id": "anaconda",
					"priority": 90,
					"when": {
						"all": ["kernel/flag:local-model-catalog"]
					}
				}
			],
			"kernel/telemetry-event": [
				{
					"id": "anaconda-logged-in",
					"name": "Anaconda Logged In"
				},
				{
					"id": "anaconda-logged-out",
					"name": "Anaconda Logged Out"
				}
			]
		}
	}
}
