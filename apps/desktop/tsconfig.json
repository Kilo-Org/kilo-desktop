{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node", "vitest/globals"],
		"paths": {
			"$config/*": ["./config/*"]
		}
	},
	"include": [
		"config/**/*.ts",
		"src/**/*.ts",
		"forge.config.ts",
		"vite.main.config.ts",
		"vite.preload.config.ts",
		"vitest.config.ts"
	]
}
