{
	"manifestVersion": 1,
	"id": "kilo.workbooks",
	"displayName": "Workbooks",
	"version": "0.1.0",
	"description": "Workbooks: where what chats learn and decide about a piece of work is kept, created from workbook templates.",
	"main": "./src/main/index.ts",
	"web": "./src/web/index.ts",
	"requires": {
		"kilo.core/server": "optional",
		"kilo.work-sessions/workspaces": "optional",
		"kilo.work-sessions/work-sessions": "optional",
		"kilo.chat/composer": "optional",
		"kilo.core/tool": "optional",
		"kilo.work-sessions/work-session-action": "optional",
		"kilo.chat/tool-renderer": "optional",
		"kilo.work-sessions/new-work-session-section": "optional"
	},
	"permissions": {
		"host": ["os"]
	},
	"extensionPoints": [
		{
			"id": "template",
			"kind": "additive",
			"description": "A workbook template offered when creating a workbook."
		}
	],
	"domainObjects": [
		{
			"id": "templates",
			"home": "main",
			"description": "The workbook templates on offer, and any skipped as invalid."
		},
		{
			"id": "workbooks",
			"home": "main",
			"description": "Every workspace's workbooks: their template and where each part lives in Pages."
		},
		{
			"id": "session-workbooks",
			"home": "main",
			"description": "Each work session's active workbook."
		}
	],
	"contributes": {
		"extensions": {
			"kilo.workbooks/template": [
				{
					"id": "coding"
				},
				{
					"id": "blank"
				}
			],
			"kernel/flag": [
				{
					"id": "workbooks",
					"description": "Shows Workbooks: start work sessions from a workbook, created from a workbook template.",
					"default": false
				}
			],
			"kilo.core/tool": [
				{
					"id": "read_workbook",
					"title": "Read the workbook",
					"readOnly": true,
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "add_plan_step",
					"title": "Add a plan step",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "set_step_status",
					"title": "Set a plan step's status",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "record_decision",
					"title": "Record a decision",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "file_item",
					"title": "File an item in the workbook",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "set_where_i_left_off",
					"title": "Update where I left off",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				}
			],
			"kilo.work-sessions/work-session-action": [
				{
					"id": "workbook",
					"placement": "start",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				}
			],
			"kilo.chat/tool-renderer": [
				{
					"id": "receipts",
					"tools": [
						"kilo.workbooks/read_workbook",
						"kilo.workbooks/add_plan_step",
						"kilo.workbooks/set_step_status",
						"kilo.workbooks/record_decision",
						"kilo.workbooks/file_item",
						"kilo.workbooks/set_where_i_left_off"
					],
					"standalone": true,
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				}
			],
			"kilo.work-sessions/new-work-session-section": [
				{
					"id": "workbooks",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				}
			]
		}
	}
}
