{
	"manifestVersion": 1,
	"id": "kilo.flags",
	"displayName": "Feature flags",
	"version": "1.0.0",
	"description": "Feature flags from LaunchDarkly, as a domain object and flag: context keys.",
	"contextKeys": [
		{
			"id": "flag:*",
			"scope": "global",
			"description": "True while the named feature flag is on."
		}
	],
	"domains": [
		{
			"id": "flags",
			"home": "main",
			"description": "Every feature flag's current value."
		}
	],
	"contributes": {
		"extensions": {
			"kernel/service": [
				{
					"id": "launchdarkly",
					"title": "Feature flags",
					"kind": "daemon",
					"startOn": "activation",
					"restart": {
						"policy": "never"
					}
				}
			]
		}
	},
	"requires": {
		"kilo.account/identity": "optional"
	}
}
