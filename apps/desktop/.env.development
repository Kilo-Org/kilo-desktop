# Public OAuth client ID for local development. OAuth client IDs are not secrets.
VITE_AUTH_CLIENT_ID=a2de2b01-8b4f-4134-b73d-981473d32f11
# Service IDs (LaunchDarkly, Sentry, PostHog) are not committed. Development never
# reports to Sentry or PostHog (view Sentry events locally via Spotlight, see README
# "Local Sentry via Spotlight"). To evaluate real feature flags locally, set
# VITE_LAUNCHDARKLY_CLIENT_SIDE_ID in an ignored apps/desktop/.env.development.local;
# without it flags resolve to their defaults and VITE_FEATURE_FLAG_OVERRIDES.
