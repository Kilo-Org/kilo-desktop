{
	"$schema": "https://v2-11-1.turborepo.dev/schema.json",
	"futureFlags": {
		"affectedUsingTaskInputs": true,
		"globalConfiguration": true
	},
	"global": {
		"inputs": ["tsconfig.base.json", "pnpm-workspace.yaml", "pnpm-lock.yaml", ".nvmrc"]
	},
	"tasks": {
		"transit": {
			"dependsOn": ["^transit"]
		},
		"check": {
			"dependsOn": ["transit"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": ["node_modules/.cache/tsconfig.tsbuildinfo"]
		},
		"test": {
			"dependsOn": ["transit"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.coverage.shared.mjs"],
			"outputs": []
		},
		"coverage": {
			"dependsOn": ["transit"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.coverage.shared.mjs"],
			"outputs": ["coverage/**"]
		},
		"test:platform": {
			"dependsOn": ["transit"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.coverage.shared.mjs"],
			"outputs": []
		},
		"build": {
			"dependsOn": ["^build", "sync:webmcp"],
			"outputs": ["dist/**"],
			"env": ["SENTRY_AUTH_TOKEN", "APP_MODE", "NODE_ENV"]
		},
		"sync:webmcp": {
			"cache": false
		},
		"db:generate": {
			"cache": false
		},
		"fetch-cli": {
			"cache": false
		},
		"dev": {
			"persistent": true,
			"cache": false
		}
	}
}
