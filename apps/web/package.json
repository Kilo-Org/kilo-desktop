{
	"name": "@kilo-desktop/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Standalone React renderer for Kilo Desktop",
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"sync:webmcp": "node scripts/sync-webmcp-assets.mjs",
		"predev": "pnpm run sync:webmcp",
		"dev": "vite",
		"prebuild": "pnpm run sync:webmcp",
		"build": "vite build",
		"test": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@kilo-desktop/contracts": "workspace:*",
		"@kilo-desktop/feature-sdk": "workspace:*",
		"@kilo-desktop/plugin-browser": "link:../../plugins/browser",
		"@kilo-desktop/plugin-environments": "workspace:*",
		"@kilo-desktop/plugin-files": "link:../../plugins/files",
		"@kilo-desktop/plugin-git": "link:../../plugins/git",
		"@kilo-desktop/plugin-kilo-server": "link:../../plugins/kilo-server",
		"@kilo-desktop/plugin-kilo-ui": "link:../../plugins/kilo-ui",
		"@kilo-desktop/plugin-local-inference": "link:../../plugins/local-inference",
		"@kilo-desktop/plugin-notebook": "link:../../plugins/notebook",
		"@kilo-desktop/plugin-terminal": "link:../../plugins/terminal",
		"@kilo-desktop/plugin-todos": "workspace:*",
		"@kilo-desktop/pane-layout": "workspace:*",
		"@kilo-desktop/sdk-react": "workspace:*",
		"@kilo-desktop/ui": "link:../../packages/ui",
		"@anaconda/shadcn-theme": "0.1.0-alpha.2",
		"@fontsource-variable/inter": "^5.3.0",
		"@mcp-b/webmcp-polyfill": "5.1.0",
		"@sentry/electron": "catalog:",
		"@sentry/react": "catalog:",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.18",
		"lucide-react": "catalog:",
		"motion": "^13.0.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-use": "catalog:",
		"tw-shimmer": "^0.4.12",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@kilo-desktop/testing": "workspace:*",
		"@sentry/vite-plugin": "catalog:",
		"@mcp-b/webmcp-local-relay": "4.0.0",
		"@mcp-b/webmcp-types": "4.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-plugin": "^1.168.23",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"@vitest/browser": "5.0.1",
		"@vitest/browser-playwright": "5.0.1",
		"@vitest/coverage-v8": "catalog:",
		"playwright": "catalog:",
		"shadcn": "^4.16.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
