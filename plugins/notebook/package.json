{
	"name": "@kilo-desktop/plugin-notebook",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "kilo.notebook \u2014 nteract notebooks in a work session's panes",
	"author": "Anaconda, Inc.",
	"license": "SEE LICENSE IN ../../LICENSE.md",
	"exports": {
		"./plugin.json": "./plugin.json",
		"./main": "./src/main/index.ts",
		"./web": "./src/web/index.ts",
		"./contracts": "./src/contracts/index.ts",
		"./packaging": "./src/packaging/index.ts"
	},
	"scripts": {
		"build-kilo-plugin": "node --env-file-if-exists=.env.local --import tsx scripts/build-kilo-plugin.ts",
		"fetch-notebook-ui": "node --env-file-if-exists=.env.local --import tsx scripts/fetch-notebook-ui.ts",
		"check": "tsc --noEmit -p tsconfig.json",
		"fetch-runtimed": "node --env-file-if-exists=.env.local --import tsx scripts/fetch-runtimed.ts",
		"prepare-assets": "pnpm run fetch-runtimed && pnpm run build-kilo-plugin && pnpm run fetch-notebook-ui",
		"stage-bundle": "pnpm run build-kilo-plugin && pnpm run fetch-notebook-ui",
		"test": "vitest run",
		"test:platform": "vitest run --project integration",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@kilo-desktop/kernel": "workspace:*",
		"@kilo-desktop/plugin-chat": "workspace:*",
		"@kilo-desktop/plugin-core": "workspace:*",
		"@kilo-desktop/plugin-shell": "workspace:*",
		"@kilo-desktop/plugin-work-sessions": "workspace:*",
		"@kilo-desktop/ui": "workspace:*",
		"koffi": "3.3.8",
		"lucide-react": "catalog:",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"@runtimed/node": "0.8.1"
	},
	"devDependencies": {
		"7zip-bin-full": "^26.2.1",
		"@runtimed/node": "0.8.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.0.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"@vitest/browser": "5.1.0",
		"@vitest/browser-playwright": "5.1.0",
		"@vitest/coverage-v8": "catalog:",
		"execa": "catalog:",
		"playwright": "catalog:",
		"tailwindcss": "^4.3.3",
		"tar": "^7.5.22",
		"tsx": "^4.23.1",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
