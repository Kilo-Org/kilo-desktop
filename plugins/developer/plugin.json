{
	"manifestVersion": 1,
	"id": "kilo.developer",
	"displayName": "Developer",
	"version": "1.0.0",
	"description": "Tools for people building and debugging Kilo: the Developer settings category and Diagnostics.",
	"web": "./src/web/index.ts",
	"when": {
		"all": ["kernel/flag:developer"]
	},
	"requires": {
		"kilo.shell/settings-category": "optional",
		"kilo.shell/settings-section": "optional"
	},
	"permissions": {
		"host": ["os", "plugins"]
	},
	"contributes": {
		"extensions": {
			"kernel/flag": [
				{
					"id": "developer",
					"description": "Developer tools: Settings → Developer → Diagnostics.",
					"default": false
				},
				{
					"id": "force-onboarding",
					"description": "Shows onboarding on every launch (development).",
					"default": false
				}
			],
			"kilo.shell/settings-category": [
				{
					"id": "developer",
					"title": "Developer",
					"priority": 100
				}
			],
			"kilo.shell/settings-section": [
				{
					"id": "diagnostics",
					"title": "Diagnostics",
					"description": "What's running: the kernel, plugins and services, flags, identity, any problems, and the domain model they share.",
					"category": "kilo.developer/developer",
					"priority": 10
				}
			]
		}
	}
}
