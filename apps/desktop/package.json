{
	"name": "@anaconda-agentic-desktop/desktop",
	"version": "0.1.1",
	"private": true,
	"type": "module",
	"description": "Electron shell for Anaconda Agentic Desktop",
	"productName": "Anaconda Agentic Desktop",
	"author": "Anaconda, Inc.",
	"license": "UNLICENSED",
	"homepage": "https://github.com/anaconda/agentic-desktop",
	"repository": {
		"type": "git",
		"url": "https://github.com/anaconda/agentic-desktop.git"
	},
	"main": ".vite/build/main.js",
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"prestart": "pnpm run prepare:plugins",
		"premake": "pnpm run prepare:build",
		"prepackage": "pnpm run prepare:build",
		"prepublish": "tsx config/preflight-publish.ts && pnpm run prepare:build",
		"prepare:build": "pnpm run prepare:web && pnpm run prepare:plugins",
		"prepare:web": "pnpm --filter @anaconda-agentic-desktop/web build && node --input-type=module -e \"import { access } from 'node:fs/promises'; await access(new URL('../web/dist/index.html', import.meta.url));\"",
		"prepare:plugins": "pnpm --filter \"@anaconda-agentic-desktop/plugin-*\" -r --if-present run prepare-assets",
		"make": "tsx config/run-packaging.ts make",
		"package": "tsx config/run-packaging.ts package",
		"package:e2e": "cross-env ELECTRON_ENABLE_INSPECT=true ELECTRON_SKIP_NATIVE_REBUILD=true pnpm run package",
		"publish": "tsx config/run-packaging.ts publish",
		"start": "electron-forge start -- --remote-debugging-port=9222",
		"test": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"dependencyNotes": {
		"ws": "PACKAGING BRIDGE: Vite leaves `ws` external in the main bundle (CJS `events` require). pnpm deploy only hoists packages declared on desktop, so a transitive kilo-server dep is not enough."
	},
	"dependencies": {
		"@anaconda-agentic-desktop/contracts": "workspace:*",
		"@anaconda-agentic-desktop/feature-sdk": "workspace:*",
		"@anaconda-agentic-desktop/plugin-environments": "workspace:*",
		"@anaconda-agentic-desktop/plugin-files": "link:../../plugins/files",
		"@anaconda-agentic-desktop/plugin-git": "workspace:*",
		"@anaconda-agentic-desktop/plugin-kilo-server": "link:../../plugins/kilo-server",
		"@anaconda-agentic-desktop/plugin-kilo-ui": "link:../../plugins/kilo-ui",
		"@anaconda-agentic-desktop/plugin-local-inference": "link:../../plugins/local-inference",
		"@anaconda-agentic-desktop/plugin-notebook": "link:../../plugins/notebook",
		"@anaconda-agentic-desktop/plugin-todos": "workspace:*",
		"@github/keytar": "^7.10.6",
		"@launchdarkly/node-client-sdk": "^4.0.0",
		"@runtimed/node": "0.5.0",
		"@sentry/electron": "catalog:",
		"@vscode/proxy-agent": "^0.44.0",
		"anaconda-opentelemetry": "0.9.2",
		"atomically": "catalog:",
		"electron-debug": "^4.1.0",
		"electron-log": "catalog:",
		"electron-squirrel-startup": "^1.0.1",
		"electron-store": "^11.0.2",
		"execa": "^9.6.0",
		"lodash": "catalog:",
		"openid-client": "^6.6.3",
		"p-defer": "^4.0.1",
		"shell-env": "^4.0.3",
		"smol-toml": "^1.3.1",
		"ws": "^8.21.3",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@anaconda-agentic-desktop/testing": "workspace:*",
		"@anaconda-agentic-desktop/vite-plugin-externalize-deps": "workspace:*",
		"@electron-forge/cli": "8.0.0-alpha.10",
		"@electron-forge/maker-deb": "8.0.0-alpha.10",
		"@electron-forge/maker-dmg": "8.0.0-alpha.10",
		"@electron-forge/maker-squirrel": "8.0.0-alpha.10",
		"@electron-forge/maker-zip": "8.0.0-alpha.10",
		"@electron-forge/plugin-fuses": "8.0.0-alpha.10",
		"@electron-forge/plugin-vite": "8.0.0-alpha.10",
		"@electron-forge/publisher-s3": "8.0.0-alpha.10",
		"@electron-forge/shared-types": "8.0.0-alpha.10",
		"@electron/fuses": "^2.0.0",
		"@playwright/test": "1.62.1",
		"@sentry/vite-plugin": "catalog:",
		"@types/electron-squirrel-startup": "1.0.2",
		"@types/lodash": "^4.17.20",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "catalog:",
		"cross-env": "^10.1.0",
		"electron": "catalog:",
		"electron-winstaller": "5.4.4",
		"playwright": "1.62.1",
		"tsx": "^4.23.1",
		"type-fest": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
