{
	"manifestVersion": 1,
	"id": "kilo.chat",
	"displayName": "Chat",
	"version": "1.0.0",
	"description": "The chat pane: a work session's chats with the agent, their transcript and composer.",
	"main": "./src/main/index.ts",
	"web": "./src/web/index.ts",
	"requires": {
		"kilo.core/server": "optional",
		"kilo.core/chats": "optional",
		"kilo.core/models": "optional",
		"kilo.core/account": "optional",
		"kilo.core/tool": "optional",
		"kilo.core/tool-approval": "optional",
		"kilo.work-sessions/workspaces": "optional",
		"kilo.work-sessions/work-sessions": "optional",
		"kilo.work-sessions/panes": "optional",
		"kilo.work-sessions/window": "optional",
		"kilo.work-sessions/pane-kind": "optional",
		"kilo.work-sessions/work-session-action": "optional",
		"kilo.work-sessions/work-session-starter": "optional",
		"kilo.work-sessions/opener": "optional",
		"kilo.work-sessions/permission-auto-answer": "optional",
		"kilo.shell/navigation": "optional",
		"kilo.shell/notifications": "optional",
		"kilo.shell/theme": "optional",
		"kilo.shell/takeover": "optional",
		"kilo.shell/reading": "optional",
		"kilo.shell/reading-presets": "optional",
		"kilo.shell/reading-usage": "optional",
		"kilo.shell/appearance": "optional",
		"kilo.work-sessions/saved-items": "optional",
		"kilo.work-sessions/saved-source": "optional"
	},
	"permissions": {
		"host": ["clipboard", "os", "windows"],
		"embeddedHosts": ["mcp-app"]
	},
	"contextKeys": [
		{
			"id": "composerFocused",
			"scope": "window",
			"description": "True while a chat composer in this window has keyboard focus."
		},
		{
			"id": "focusAvailable",
			"scope": "window",
			"description": "True while the active pane in this window can be read in Focus (a reply or a plan), or Focus is open."
		}
	],
	"domainObjects": [
		{
			"id": "composer",
			"home": "renderer",
			"description": "This window's composers: focus, insert, start a new chat."
		},
		{
			"id": "drafts",
			"home": "main",
			"description": "Unsent composer text by work session, for every window."
		},
		{
			"id": "prompt-queues",
			"home": "main",
			"description": "Prompts queued while a chat works, sent in order when it goes idle, from any window."
		},
		{
			"id": "auto-approve",
			"home": "main",
			"description": "Whether the agent's permission requests are answered automatically."
		},
		{
			"id": "html-pages",
			"home": "main",
			"description": "Saves the agent's HTML pages into a workspace folder."
		},
		{
			"id": "media-viewers",
			"home": "main",
			"description": "The diagrams and images each media viewer pane shows, kept until it closes."
		}
	],
	"extensionPoints": [
		{
			"id": "composer-action",
			"kind": "additive",
			"description": "A button, menu or popover in the composer."
		},
		{
			"id": "composer-mention",
			"kind": "additive",
			"description": "Mentions typed after a trigger character, resolved into agent context."
		},
		{
			"id": "client-slash-command",
			"kind": "additive",
			"description": "Places a kernel command in the composer's / menu."
		},
		{
			"id": "tool-renderer",
			"kind": "additive",
			"description": "How calls to a tool look in the chat transcript."
		},
		{
			"id": "mcp-app",
			"kind": "additive",
			"description": "An interactive MCP App widget shown for a tool's calls."
		},
		{
			"id": "markdown-extension",
			"kind": "additive",
			"description": "Remark plugins and component decorators for the transcript's markdown."
		},
		{
			"id": "permission-renderer",
			"kind": "additive",
			"description": "Details and policies for the agent's permission requests and questions."
		},
		{
			"id": "model-source",
			"kind": "additive",
			"description": "A local model provider: its model picker rail and model loading before prompts."
		}
	],
	"contributes": {
		"extensions": {
			"kilo.work-sessions/pane-kind": [
				{
					"id": "agent",
					"title": "Agent",
					"description": "Ask the agent to plan, write and run code in this session.",
					"launch": {
						"newSession": true,
						"inSession": true
					},
					"keepAlive": true,
					"layoutKind": "agent",
					"order": 10
				},
				{
					"id": "plan",
					"title": "Plan",
					"description": "The plan agent's proposed plan for a chat.",
					"launch": {
						"newSession": false,
						"inSession": false
					},
					"singleton": true,
					"order": 20
				},
				{
					"id": "subagent",
					"title": "Subagent",
					"description": "A subagent's conversation, live and read-only.",
					"launch": {
						"newSession": false,
						"inSession": false
					},
					"order": 30
				},
				{
					"id": "media",
					"title": "Viewer",
					"description": "A chat's diagrams and images, to zoom, pan and download.",
					"launch": {
						"newSession": false,
						"inSession": false
					},
					"layoutKind": "document",
					"order": 40
				}
			],
			"kilo.work-sessions/work-session-action": [
				{
					"id": "agents",
					"placement": "end",
					"priority": 10
				}
			],
			"kilo.work-sessions/opener": [
				{
					"id": "chat",
					"match": {
						"type": "kilo.core/chat"
					},
					"pane": "kilo.chat/agent"
				}
			],
			"kilo.work-sessions/work-session-starter": [
				{
					"id": "composer",
					"title": "Agent",
					"paneKind": "kilo.chat/agent"
				}
			],
			"kilo.work-sessions/permission-auto-answer": [
				{
					"id": "auto-approve"
				}
			],
			"kernel/command": [
				{
					"id": "focus-composer",
					"title": "Focus the message input",
					"category": "Composer",
					"order": 0,
					"keybinding": {
						"mac": "Mod+L",
						"default": "Ctrl+Shift+L"
					},
					"when": {
						"all": ["kilo.work-sessions/workSessionActive"]
					}
				},
				{
					"id": "send-message",
					"title": "Send message",
					"category": "Composer",
					"order": 10,
					"keybinding": "Enter",
					"handledLocally": true,
					"palette": false
				},
				{
					"id": "new-line",
					"title": "New line",
					"category": "Composer",
					"order": 11,
					"keybinding": "Shift+Enter",
					"handledLocally": true,
					"palette": false
				},
				{
					"id": "cycle-agent",
					"title": "Change agent mode",
					"category": "Composer",
					"order": 12,
					"keybinding": "Shift+Tab",
					"handledLocally": true,
					"palette": false
				},
				{
					"id": "compact",
					"title": "Compact the chat",
					"category": "Composer",
					"order": 20,
					"palette": false
				},
				{
					"id": "toggle-focus",
					"title": "Focus",
					"category": "Reading",
					"order": 0,
					"keybinding": {
						"mac": "Mod+Shift+F",
						"default": "Ctrl+Shift+F"
					},
					"when": {
						"all": ["kilo.chat/focusAvailable"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "exit-focus",
					"title": "Exit Focus",
					"category": "Reading",
					"order": 1,
					"keybinding": "Escape",
					"handledLocally": true,
					"palette": false
				},
				{
					"id": "focus-move",
					"title": "Move between paragraphs in Focus",
					"category": "Reading",
					"order": 2,
					"keybinding": ["ArrowUp", "ArrowDown"],
					"handledLocally": true,
					"palette": false
				}
			],
			"kilo.chat/composer-action": [
				{
					"id": "attach",
					"slot": "toolbar",
					"kind": "action",
					"title": "Add attachment",
					"priority": 400
				},
				{
					"id": "agent",
					"slot": "toolbar",
					"kind": "menu",
					"title": "Agent",
					"priority": 300
				},
				{
					"id": "model",
					"slot": "toolbar",
					"kind": "popover",
					"title": "Model",
					"priority": 200
				},
				{
					"id": "approval",
					"slot": "toolbar-end",
					"kind": "menu",
					"title": "Approval mode",
					"priority": 100
				},
				{
					"id": "unavailable-folders",
					"slot": "footer",
					"kind": "view",
					"title": "Unavailable workspace folders",
					"priority": 200
				},
				{
					"id": "unavailable-folders-draft",
					"slot": "draft-footer",
					"kind": "view",
					"title": "Unavailable workspace folders",
					"priority": 200
				}
			],
			"kilo.chat/client-slash-command": [
				{
					"id": "compact",
					"command": "kilo.chat/compact",
					"name": "compact",
					"description": "Summarize the chat so far to free up context",
					"aliases": ["smol", "condense"]
				}
			],
			"kilo.core/tool": [
				{
					"id": "html_render",
					"title": "Show HTML page",
					"readOnly": true,
					"external": false
				}
			],
			"kilo.core/tool-approval": [
				{
					"id": "auto-approve"
				}
			],
			"kilo.chat/tool-renderer": [
				{
					"id": "read",
					"tools": ["read"]
				},
				{
					"id": "edit",
					"tools": ["edit"]
				},
				{
					"id": "write",
					"tools": ["write"]
				},
				{
					"id": "bash",
					"tools": ["bash"]
				},
				{
					"id": "search",
					"tools": ["grep", "codebase_search", "semantic_search"]
				},
				{
					"id": "glob",
					"tools": ["glob", "list"]
				},
				{
					"id": "web-search",
					"tools": ["websearch", "webSearch"]
				},
				{
					"id": "web-fetch",
					"tools": ["webfetch", "webFetch"]
				},
				{
					"id": "apply-patch",
					"tools": ["apply_patch"]
				},
				{
					"id": "skill",
					"tools": ["skill"]
				},
				{
					"id": "task",
					"tools": ["task"]
				},
				{
					"id": "question",
					"tools": ["question", "ask_question", "request_user_input", "requestUserInput"]
				},
				{
					"id": "todo",
					"tools": ["todowrite", "todoread"]
				},
				{
					"id": "html-render",
					"tools": ["kilo.chat/html_render", "desktop_kilo_ui_html_render"]
				},
				{
					"id": "plan-exit",
					"tools": ["plan_exit"],
					"standalone": true,
					"category": "planning"
				}
			],
			"kilo.shell/takeover": [
				{
					"id": "focus",
					"title": "Focus"
				}
			],
			"kernel/telemetry-event": [
				{
					"id": "chat-forked",
					"name": "Chat Forked"
				},
				{
					"id": "focus-entered",
					"name": "Focus Entered"
				},
				{
					"id": "focus-exited",
					"name": "Focus Exited"
				},
				{
					"id": "focus-entry-failed",
					"name": "Focus Entry Failed"
				},
				{
					"id": "reading-control-opened",
					"name": "Reading Control Opened"
				},
				{
					"id": "reading-setting-changed",
					"name": "Reading Setting Changed"
				},
				{
					"id": "focus-round-trip",
					"name": "Focus Round Trip"
				},
				{
					"id": "focus-excerpt-used-in-prompt",
					"name": "Focus Excerpt Used In Prompt"
				},
				{
					"id": "saved-item-added",
					"name": "Saved Item Added"
				},
				{
					"id": "saved-item-removed",
					"name": "Saved Item Removed"
				},
				{
					"id": "saved-toast-action",
					"name": "Saved Toast Action"
				},
				{
					"id": "selection-menu-used",
					"name": "Selection Menu Used"
				},
				{
					"id": "saved-action-failed",
					"name": "Saved Action Failed"
				}
			],
			"kilo.work-sessions/saved-source": [
				{
					"id": "chat-text",
					"label": "Saved text",
					"presentation": "quote",
					"filter": "text"
				},
				{
					"id": "chat-bookmark",
					"label": "Bookmarked chat",
					"presentation": "bookmark",
					"filter": "chats"
				}
			]
		}
	}
}
