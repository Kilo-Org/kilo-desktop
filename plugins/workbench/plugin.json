{
	"manifestVersion": 1,
	"id": "kilo.workbench",
	"displayName": "Workbench",
	"version": "1.0.0",
	"description": "The session list, the launcher and the open session's workbench.",
	"requires": {
		"kilo.sessions/work-session": "optional",
		"kilo.flags/flags": "optional",
		"kilo.workspaces/workspace": "optional",
		"kilo.shell/main": "optional",
		"kilo.shell/left-sidebar": "optional",
		"kilo.shell/navigation": "optional",
		"kilo.sessions/pane": "optional",
		"kilo.sessions/pane-kind": "optional",
		"kilo.agent/conversation": "optional",
		"kilo.shell/settings-section": "optional",
		"kernel/windows": "optional",
		"kernel/notifications": "optional",
		"kilo.telemetry/telemetry": "optional",
		"kilo.telemetry/telemetry-event": "optional",
		"kilo.shell/menu-item": "optional"
	},
	"contextKeys": [
		{
			"id": "sessionActive",
			"scope": "window",
			"description": "True while a session is open in this window."
		},
		{
			"id": "paneTargetActive",
			"scope": "window",
			"description": "True while opening a pane has somewhere to go: an open session, or the New Session page, which starts a session with it."
		},
		{
			"id": "workspaceActive",
			"scope": "window",
			"description": "True while the session list is focused on one workspace."
		}
	],
	"extensionPoints": [
		{
			"id": "session-menu",
			"kind": "additive",
			"description": "An item in a session's menu."
		},
		{
			"id": "session-decoration",
			"kind": "additive",
			"description": "A badge or hover detail shown with a session."
		},
		{
			"id": "session-action",
			"kind": "additive",
			"description": "A button in an open session's header."
		},
		{
			"id": "pane-kind-menu",
			"kind": "additive",
			"description": "Entries in the header menu of a pinned pane kind."
		},
		{
			"id": "navigator-action",
			"kind": "additive",
			"description": "A button in the session list's header."
		},
		{
			"id": "launcher-option",
			"kind": "additive",
			"description": "A session-creation option under the launcher's buttons."
		},
		{
			"id": "session-starter",
			"kind": "exclusive",
			"description": "The New Session page's body: how a person starts a session."
		},
		{
			"id": "session-facet",
			"kind": "additive",
			"description": "Read-only facts about sessions the session list filters by."
		},
		{
			"id": "sessions-view",
			"kind": "additive",
			"description": "Another view of the sessions, shown in place of the open session."
		}
	],
	"domains": [
		{
			"id": "workbench",
			"home": "renderer",
			"description": "This window's view of the Work Sessions: focused workspace, open session or sessions view, and opening panes."
		},
		{
			"id": "layouts",
			"home": "main",
			"description": "Saved layout presets and the default one."
		}
	],
	"contributes": {
		"extensions": {
			"kilo.shell/main": [
				{
					"id": "workbench",
					"title": "Sessions"
				}
			],
			"kilo.shell/left-sidebar": [
				{
					"id": "sessions"
				}
			],
			"kilo.shell/settings-section": [
				{
					"id": "notifications",
					"title": "Notifications",
					"description": "A sound, plus a system notification while Kilo is in the background. “When I'm not looking” skips the session you have open.",
					"priority": 72
				}
			],
			"kilo.workbench/session-action": [
				{
					"id": "layouts",
					"when": {
						"all": ["kilo.flags/flag:chat-layouts"]
					}
				}
			],
			"kernel/command": [
				{
					"id": "new-session",
					"title": "New session",
					"category": "Sessions",
					"order": 30,
					"keybinding": [
						{
							"mac": "Mod+N",
							"default": "Ctrl+Shift+N"
						},
						"Mod+Shift+O"
					],
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "new-empty-session",
					"title": "New empty session",
					"category": "Sessions",
					"order": 31,
					"when": {
						"all": ["kilo.workbench/paneTargetActive"],
						"none": ["kilo.workbench/sessionActive"]
					}
				},
				{
					"id": "search",
					"title": "Search sessions and workspaces",
					"category": "Sessions",
					"order": 0,
					"keybinding": {
						"mac": "Mod+K",
						"default": "Ctrl+Shift+K"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "next-session",
					"title": "Next session",
					"category": "Sessions",
					"order": 20,
					"keybinding": [
						"Ctrl+Tab",
						{
							"mac": "Mod+Alt+ArrowDown",
							"default": "Alt+ArrowDown"
						}
					],
					"repeatable": true,
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "previous-session",
					"title": "Previous session",
					"category": "Sessions",
					"order": 21,
					"keybinding": [
						"Ctrl+Shift+Tab",
						{
							"mac": "Mod+Alt+ArrowUp",
							"default": "Alt+ArrowUp"
						}
					],
					"repeatable": true,
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "next-attention-session",
					"title": "Go to next session that needs attention",
					"category": "Sessions",
					"order": 22,
					"keybinding": {
						"mac": "Mod+Alt+A",
						"default": "Ctrl+Shift+A"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "toggle-pin-session",
					"title": "Pin or unpin session",
					"category": "Sessions",
					"order": 31,
					"keybinding": {
						"mac": "Mod+Alt+P",
						"default": "Ctrl+Alt+P"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "session-1",
					"title": "Go to session 1",
					"category": "Sessions",
					"order": 1,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+1",
						"default": "Alt+1"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "session-2",
					"title": "Go to session 2",
					"category": "Sessions",
					"order": 2,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+2",
						"default": "Alt+2"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "session-3",
					"title": "Go to session 3",
					"category": "Sessions",
					"order": 3,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+3",
						"default": "Alt+3"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "session-4",
					"title": "Go to session 4",
					"category": "Sessions",
					"order": 4,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+4",
						"default": "Alt+4"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "session-5",
					"title": "Go to session 5",
					"category": "Sessions",
					"order": 5,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+5",
						"default": "Alt+5"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "session-6",
					"title": "Go to session 6",
					"category": "Sessions",
					"order": 6,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+6",
						"default": "Alt+6"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "session-7",
					"title": "Go to session 7",
					"category": "Sessions",
					"order": 7,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+7",
						"default": "Alt+7"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "session-8",
					"title": "Go to session 8",
					"category": "Sessions",
					"order": 8,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+8",
						"default": "Alt+8"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "session-last",
					"title": "Go to last session",
					"category": "Sessions",
					"order": 9,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+9",
						"default": "Alt+9"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "new-pane",
					"title": "New tab",
					"category": "Tabs",
					"order": 30,
					"keybinding": {
						"mac": "Mod+T",
						"default": "Ctrl+Shift+T"
					},
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "close-pane",
					"title": "Close tab",
					"category": "Tabs",
					"order": 31,
					"keybinding": {
						"mac": "Mod+W",
						"default": "Ctrl+Shift+W"
					},
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "new-group-right",
					"title": "New group to the right",
					"category": "Tabs",
					"order": 32,
					"keybinding": {
						"mac": "Mod+\\",
						"default": "Ctrl+Shift+\\"
					},
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "new-group-below",
					"title": "New group below",
					"category": "Tabs",
					"order": 33,
					"keybinding": {
						"mac": "Alt+Mod+\\",
						"default": "Ctrl+Alt+Shift+\\"
					},
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "next-pane",
					"title": "Next tab",
					"category": "Tabs",
					"order": 20,
					"repeatable": true,
					"keybinding": {
						"mac": "Mod+Alt+ArrowRight",
						"default": "Ctrl+PageDown"
					},
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "previous-pane",
					"title": "Previous tab",
					"category": "Tabs",
					"order": 21,
					"repeatable": true,
					"keybinding": {
						"mac": "Mod+Alt+ArrowLeft",
						"default": "Ctrl+PageUp"
					},
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "toggle-carousel",
					"title": "Toggle carousel",
					"category": "Tabs",
					"order": 40,
					"keybinding": {
						"mac": "Ctrl+Mod+C",
						"default": "Ctrl+Alt+C"
					},
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "pane-1",
					"title": "Go to tab 1",
					"category": "Tabs",
					"order": 1,
					"palette": false,
					"keybinding": "Mod+1",
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "pane-2",
					"title": "Go to tab 2",
					"category": "Tabs",
					"order": 2,
					"palette": false,
					"keybinding": "Mod+2",
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "pane-3",
					"title": "Go to tab 3",
					"category": "Tabs",
					"order": 3,
					"palette": false,
					"keybinding": "Mod+3",
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "pane-4",
					"title": "Go to tab 4",
					"category": "Tabs",
					"order": 4,
					"palette": false,
					"keybinding": "Mod+4",
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "pane-5",
					"title": "Go to tab 5",
					"category": "Tabs",
					"order": 5,
					"palette": false,
					"keybinding": "Mod+5",
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "pane-6",
					"title": "Go to tab 6",
					"category": "Tabs",
					"order": 6,
					"palette": false,
					"keybinding": "Mod+6",
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "pane-7",
					"title": "Go to tab 7",
					"category": "Tabs",
					"order": 7,
					"palette": false,
					"keybinding": "Mod+7",
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "pane-8",
					"title": "Go to tab 8",
					"category": "Tabs",
					"order": 8,
					"palette": false,
					"keybinding": "Mod+8",
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "pane-last",
					"title": "Go to last tab",
					"category": "Tabs",
					"order": 9,
					"palette": false,
					"keybinding": "Mod+9",
					"when": {
						"all": ["kilo.workbench/sessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "open-session",
					"title": "Open session",
					"category": "Sessions",
					"palette": false
				},
				{
					"id": "show-sessions-view",
					"title": "Show sessions view",
					"category": "Sessions",
					"palette": false
				}
			],
			"kilo.telemetry/telemetry-event": [
				{
					"id": "pane-opened",
					"name": "Pane Opened"
				},
				{
					"id": "pane-closed",
					"name": "Pane Closed"
				},
				{
					"id": "layout-arrangement-changed",
					"name": "Layout Arrangement Changed"
				},
				{
					"id": "layout-preset-applied",
					"name": "Layout Preset Applied"
				},
				{
					"id": "layout-preset-saved",
					"name": "Layout Preset Saved"
				},
				{
					"id": "layout-preset-removed",
					"name": "Layout Preset Removed"
				},
				{
					"id": "layout-preset-default-changed",
					"name": "Layout Preset Default Changed"
				}
			],
			"kernel/window-view": [
				{
					"id": "pane",
					"title": "Pane",
					"width": 720,
					"height": 720
				},
				{
					"id": "sessions-view-window",
					"title": "Sessions",
					"width": 1240,
					"height": 760
				}
			],
			"kilo.shell/menu-item": [
				{
					"id": "new-session",
					"command": "kilo.workbench/new-session",
					"menu": "file",
					"group": "session",
					"priority": 30
				},
				{
					"id": "new-pane",
					"command": "kilo.workbench/new-pane",
					"menu": "file",
					"group": "tab",
					"priority": 20
				},
				{
					"id": "close-pane",
					"command": "kilo.workbench/close-pane",
					"menu": "file",
					"group": "tab",
					"priority": 10
				}
			]
		}
	},
	"permissions": {
		"host": ["windows", "notifications"]
	}
}
