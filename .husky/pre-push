# Mirror the checks from .github/workflows/ci.yml so pushes don't fail in CI.
# lint/format stay full (sub-2s; global config changes can affect any file).
# check/test are scoped to changed packages (+ dependents) for speed; a git
# fetch keeps origin/main current for tightest scoping. The workspace root is
# excluded from the filter so its recursive check/test scripts cannot nest a
# second full suite (which races Vitest browser mode). Full suite runs in CI.
pnpm lint
pnpm format:check
pnpm check:changed
pnpm test:changed
