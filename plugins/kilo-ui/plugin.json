{
	"id": "kilo-ui",
	"displayName": "Kilo UI",
	"version": "1.0.0",
	"main": "./src/main/index.ts",
	"web": "./src/web/index.ts",
	"zones": [
		{ "id": "chat-right-panel-tab" },
		{ "id": "chat-markdown-extension" },
		{ "id": "chat-composer-trigger" },
		{ "id": "chat-composer-draft-footer" },
		{ "id": "chat-composer-footer" },
		{ "id": "chat-header-actions" },
		{ "id": "chat-session-row-metadata" },
		{ "id": "chat-session-metadata-provider" },
		{ "id": "chat-session-details-branch" },
		{ "id": "chat-session-details-pull-request" }
	],
	"contributes": {
		"providers": [
			{ "component": "WorkspacesFeatureProvider", "priority": 20 },
			{ "component": "ChatFeatureProvider", "priority": 10 },
			{ "component": "OnboardingProvider", "priority": 5 }
		],
		"routes": [
			{
				"path": "/chat",
				"component": "ChatPage",
				"title": "Chat",
				"surface": "transparent",
				"header": { "leading": "ChatPageHeaderLeading", "actions": "ChatPageHeaderActions" }
			}
		],
		"nav": [],
		"zones": [
			{ "zone": "sidebar", "component": "SessionList", "label": "Chats", "priority": 10 },
			{
				"zone": "sidebar-account",
				"component": "SidebarKiloAccount",
				"label": "Kilo account",
				"priority": 10
			}
		],
		"settings": [
			{
				"id": "account",
				"title": "Account",
				"description": "See where you are signed in and manage your accounts.",
				"component": "AccountSettings",
				"icon": "AccountNavIcon",
				"category": "General",
				"priority": 105
			},
			{
				"id": "kilo-providers",
				"title": "AI Providers",
				"description": "Choose where your models come from.",
				"component": "KiloProvidersSettings",
				"icon": "KiloProvidersNavIcon",
				"category": "AI",
				"priority": 90
			}
		]
	}
}
