{
	"name": "@kilo-desktop/plugin-kilo-server",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Kilo CLI packaging and server lifecycle",
	"exports": {
		"./plugin.json": "./plugin.json",
		"./main": "./src/main/index.ts",
		"./web": "./src/web/index.ts",
		"./contracts": "./src/contracts/schemas.ts",
		"./cli-distribution": "./src/main/cli-distribution/index.ts",
		"./packaged-assets": "./src/main/resolve-plugin-asset.ts"
	},
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"fetch-cli": "tsx scripts/fetch-cli.ts",
		"prepare-assets": "pnpm run fetch-cli",
		"test": "vitest run",
		"test:platform": "vitest run --project integration",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@kilo-desktop/feature-sdk": "workspace:*",
		"@electron/fuses": "^2.1.3",
		"@mcp-b/webmcp-local-relay": "5.1.0",
		"atomically": "catalog:",
		"execa": "catalog:",
		"jsonc-parser": "^3.3.1",
		"lodash": "catalog:",
		"zod": "catalog:"
	},
	"optionalDependencies": {
		"@kilocode/cli-darwin-arm64": "7.7.9",
		"@kilocode/cli-linux-arm64": "7.7.9",
		"@kilocode/cli-linux-x64-baseline": "7.7.9",
		"@kilocode/cli-windows-x64-baseline": "7.7.9"
	},
	"devDependencies": {
		"@kilo-desktop/testing": "workspace:*",
		"@types/lodash": "^4.17.20",
		"@types/node": "^24.13.3",
		"tsx": "^4.23.1",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
