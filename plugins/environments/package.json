		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.0.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/browser": "5.1.0",
		"@vitest/browser-playwright": "5.1.0",
		"@vitest/coverage-v8": "catalog:",
		"oxc-transform-react": "~0.156.0",
		"playwright": "catalog:",
		"tailwindcss": "^4.3.5",
