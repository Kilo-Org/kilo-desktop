{
	"name": "@kilo-desktop/plugin-git",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Git plugin exposing repository status, a working-directory diff viewer, and branch switching via git-client",
	"exports": {
		"./plugin.json": "./plugin.json",
		"./main": "./src/main/index.ts",
		"./web": "./src/web/index.ts",
		"./contracts": "./src/contracts/schemas.ts"
	},
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@kilo-desktop/git-client": "workspace:*",
		"@pierre/diffs": "catalog:",
		"@pierre/trees": "catalog:",
