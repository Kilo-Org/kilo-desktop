	"overrides": [
		{
			"files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
			"rules": {
				"constructor-super": "off",
				"getter-return": "off",
				"no-class-assign": "off",
				"no-const-assign": "off",
				"no-dupe-class-members": "off",
				"no-dupe-keys": "off",
				"no-func-assign": "off",
				"no-import-assign": "off",
				"no-new-native-nonconstructor": "off",
				"no-obj-calls": "off",
				"no-redeclare": "off",
				"no-setter-return": "off",
				"no-this-before-super": "off",
				"no-unreachable": "off",
				"no-unsafe-negation": "off",
				"no-var": "error",
				"no-with": "off",
				"prefer-const": "error",
				"prefer-rest-params": "error",
				"prefer-spread": "error"
			}
		},
		{
			"files": ["apps/web/src/**/*.ts", "apps/web/src/**/*.tsx"],
			"env": {
				"browser": true
			}
		},
		{
			"files": ["apps/desktop/src/main/features/*/*Service.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "electron",
								"message": "Services must stay Electron-free. Put Electron usage in handlers or platform/."
							}
						]
					}
				]
			}
		},
		{
			"files": ["**/*.browser.test.ts", "**/*.browser.test.tsx"],
			"env": {
				"browser": true
			}
		},
		{
			"files": ["packages/ui/src/components/**"],
			"rules": {
				"no-restricted-imports": "off"
			}
		},
		{
			"files": [
				"apps/web/src/**/*.{ts,tsx}",
				"packages/kernel/src/**/*.{ts,tsx}",
				"packages/pane-layout/src/**/*.{ts,tsx}",
				"packages/ui/src/**/*.{ts,tsx}",
				"plugins/*/src/**/*.{ts,tsx}"
			],
			"excludeFiles": [
				"**/main/**",
				"**/test/**",
				"**/e2e/**",
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/test-harness.tsx",
				"**/test-helpers.tsx"
			],
			"rules": {
				"react/exhaustive-effect-dependencies": "error",
				"react/globals": "error",
				"react/hooks": "error",
				"react/immutability": "error",
				"react/memo-dependencies": "error",
				"react/preserve-manual-memoization": "error",
				"react/purity": "error",
				"react/refs": "error",
				"react/set-state-in-effect": "error",
				"react/set-state-in-render": "error",
				"react/static-components": "error",
				"react/unsupported-syntax": "error",
				"kilo/no-component-in-factory": "error",
				"kilo/no-hookless-use-function": "error",
				"kilo/no-manual-memo": "error"
			}
		},
		{
			"files": [
				"plugins/chat/src/web/selection/kilo-model-selector.tsx",
				"plugins/environments/src/web/providers/conda/EnvironmentDetail.tsx",
				"plugins/work-sessions/src/web/list/SessionList.tsx"
			],
			"rules": {
				"kilo/no-manual-memo": [
					"error",
					{
						"allowDirectives": true
					}
				]
			}
		},
		{
			"files": ["packages/ui/src/components/field.tsx", "packages/ui/src/components/sidebar.tsx"],
			"rules": {
				"kilo/no-manual-memo": "off"
			}
		}
	],
	"jsPlugins": ["./packages/oxlint-plugin/src/index.ts"]
}
