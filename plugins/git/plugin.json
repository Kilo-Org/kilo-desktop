{
	"id": "git",
	"displayName": "Git",
	"version": "1.0.0",
	"main": "./src/main/index.ts",
	"web": "./src/web/index.ts",
	"protocols": ["kilo-git"],
	"contributes": {
		"providers": [
			{ "component": "GitRepositoryWatcherProvider" },
			{ "component": "GitPrStatusProvider", "priority": 4 },
			{ "component": "GitEventsProvider", "priority": 5 }
		],
		"zones": [
			{
				"zone": "kilo-ui/chat-session-metadata-provider",
				"id": "pull-request-targets",
				"component": "GitPrStatusTargets",
				"label": "Pull request status targets",
				"priority": 100
			},
			{
				"zone": "kilo-ui/chat-session-row-metadata",
				"id": "branch-and-pull-request",
				"component": "GitSessionRowMetadata",
				"label": "Branch and pull request",
				"priority": 100
			},
			{
				"zone": "kilo-ui/chat-session-details-branch",
				"id": "session-branch",
				"component": "GitSessionDetailsBranch",
				"label": "Session branch",
				"priority": 100
			},
			{
				"zone": "kilo-ui/chat-session-details-pull-request",
				"id": "session-pull-request",
				"component": "GitSessionDetailsPullRequest",
				"label": "Session pull request",
				"priority": 100
			},
			{
				"zone": "kilo-ui/chat-header-actions",
				"id": "repository-actions",
				"component": "GitActionsControl",
				"label": "Repository actions",
				"priority": 100
			},
			{
				"zone": "kilo-ui/chat-composer-draft-footer",
				"id": "draft-menus",
				"component": "GitDraftMenus",
				"label": "Git"
			},
			{
				"zone": "kilo-ui/chat-composer-footer",
				"id": "branch-label",
				"component": "GitBranchLabel",
				"label": "Branch"
			},
			{
				"zone": "kilo-ui/chat-right-panel-tab",
				"id": "changes",
				"component": "GitDiffView",
				"label": "Changes",
				"description": "Review uncommitted changes in this chat's workspace.",
				"icon": "GitDiffTabIcon",
				"priority": 55
			}
		]
	}
}
