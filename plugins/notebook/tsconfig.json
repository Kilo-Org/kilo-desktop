{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"noEmit": true,
		"types": ["node", "vite/client"],
		"paths": {
			"@runtimed/node/electron": ["./types/runtimed-node/electron.ts"],
			"@runtimed/node/relay": ["./types/runtimed-node/relay.ts"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"scripts/**/*.ts",
		"e2e/**/*.ts",
		"types/**/*.ts",
		"vitest.config.ts"
	]
}
