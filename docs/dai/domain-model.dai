<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:dai="https://dai.studio/schema/dai/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_DomainModel"
  targetNamespace="https://dai.studio/workflow">

  <bpmn:process id="Process_DomainModel" name="Kilo Desktop Domain Model" isExecutable="false">
    <bpmn:extensionElements>
      <dai:workflowMeta
        description="Product domain model as implemented. Desktop-owned: Workspace, File, Notebook, Environment, Local Model. The conversation is a Kilo Session. Desktop does not persist a Chat Session / Session Reference entity. Workspace linkage is a blob stamped onto Kilo metadata; live attention is a renderer SessionActivity map keyed by Kilo session id. There is no Project or Conversation entity."
        defaultModel="gpt-4o"
        targetLanguage="TypeScript"
        targetFramework="React / Electron"
        version="1.0" />
    </bpmn:extensionElements>

    <bpmn:task id="Ctx_Language" name="Ubiquitous language" stepType="context"
      source="manual" format="plain" scope="global"
      content="Desktop-owned: Workspace, Workspace Folder, File, Notebook, Environment, Package, Local Model. Kilo-owned: Kilo Session, Message, Part, Agent, Provider, Model, Plan, Permission, Question, Skill, MCP Server. Sidebar Chats are Kilo Sessions (filtered by metadata.kilo-desktop). Thread is an assistant-ui synonym for Kilo Session. There is no Session Reference type in code. Do not invent Project or Conversation." />

    <bpmn:task id="Rule_NoProject" name="No Project entity" stepType="rule"
      scope="global" rulePriority="critical" enforcement="hard"
      notes="A Workspace is not a repository and not a Project. Folder basename may look like a project name in the UI, but there is no Project aggregate. Git/worktrees are deferred. Session working directory is the primary folder today; do not assume that is permanent." />

    <bpmn:task id="Rule_SoftLink" name="No desktop Session entity" stepType="rule"
      scope="global" rulePriority="critical" enforcement="hard"
      notes="There is no Chat Session / Session Reference table or type. The conversation lives in Kilo. Desktop attaches extras in three separate places keyed by Kilo session id: (1) metadata.kilo-desktop stamped onto the Kilo record, (2) in-memory SessionActivity plus lastVisitedAt in localStorage, (3) pins and right-panel state in other localStorage keys. Unscoped chats omit workspaceId and use an app-owned cwd under userData/chats/." />

    <!-- ── Workspace aggregate ─────────────────────────────────────────── -->

    <bpmn:subProcess id="Group_Workspace" name="Workspace"
      notes="Named collection of folders. Exactly one primary folder is the agent cwd in v1. Other folders are reference folders, auto-allowed for that workspace's sessions only — never via manual permission prompts, and never granted to other workspaces' sessions.">

      <bpmn:task id="Model_Workspace" name="Workspace" stepType="model" modelFormat="typescript"
        notes="Owned by kilo-ui. Persisted in plugins/kilo-ui/data.db tables workspaces and workspace_folders. Color is an identity hex used in the picker and session chrome.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="id" type="str" />
            <dai:property name="name" type="str" />
            <dai:property name="color" type="str" />
            <dai:property name="folders" type="list" />
            <dai:property name="createdAt" type="int" />
            <dai:property name="updatedAt" type="int" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_Folder" name="Workspace Folder" stepType="model" modelFormat="typescript"
        notes="One filesystem directory belonging to a workspace. isPrimary=true marks the agent working directory. position orders the folder list. path is absolute. Reference folders (isPrimary=false) are granted to sessions of this workspace via session-scoped permission.external_directory rules.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="id" type="str" />
            <dai:property name="path" type="str" />
            <dai:property name="isPrimary" type="bool" />
            <dai:property name="position" type="int" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Rule_OnePrimary" name="Exactly one primary folder" stepType="rule"
        scope="local" rulePriority="critical" enforcement="hard"
        notes="Every workspace has at least one folder and exactly one primary folder. The primary path is what Kilo receives as directory when preparing a session." />

      <bpmn:sequenceFlow id="Flow_WsFolder" sourceRef="Model_Workspace" targetRef="Model_Folder" name="1..* folders" />
      <bpmn:sequenceFlow id="Flow_Primary" sourceRef="Model_Folder" targetRef="Rule_OnePrimary" name="one is primary" />

    </bpmn:subProcess>

    <!-- ── Chat session aggregate ──────────────────────────────────────── -->

    <bpmn:subProcess id="Group_Session" name="Kilo Session (sidebar Chat)"
      notes="Sidebar items are Kilo Sessions, filtered to those with metadata.kilo-desktop. No desktop Session row. Workspace-scoped sessions use the primary folder as directory; unscoped sessions use userData/chats/session-*. Desktop extras are sidecar maps, not an encapsulating entity.">

      <bpmn:task id="Model_KiloSession" name="Kilo Session" stepType="model" modelFormat="typescript"
        notes="The conversation. Owned by the Kilo server. Desktop reads it through the Kilo SDK / assistant-ui thread list. Title, directory, status, messages live here. We do not copy them into kilo-ui SQLite.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="id" type="str" />
            <dai:property name="title" type="str" />
            <dai:property name="directory" type="str" />
            <dai:property name="status" type="str" />
            <dai:property name="createdAt" type="int" />
            <dai:property name="updatedAt" type="int" />
            <dai:property name="metadata" type="dict" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_KiloDesktopMeta" name="KiloDesktopSessionMetadata" stepType="model" modelFormat="typescript"
        notes="Blob stamped onto Kilo session.metadata.kilo-desktop at create. Not a standalone row. Presence of this blob is how the sidebar filter recognizes sessions this app created. workspaceId omitted = unscoped.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="workspaceId" type="str" />
            <dai:property name="workspaceFolders" type="list" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_SessionActivity" name="SessionActivity" stepType="model" modelFormat="typescript"
        notes="Renderer Zustand map keyed by Kilo session id. Not persisted as an entity. Mirrors live SSE (status, pending permission/question ids, timestamps) plus lastVisitedAt in localStorage kilo-ui:thread-last-visited:v1. Pins and right-panel state are yet more localStorage maps on the same id.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="directory" type="str" />
            <dai:property name="workspaceId" type="str" />
            <dai:property name="status" type="str" />
            <dai:property name="pendingPermissionIds" type="list" />
            <dai:property name="pendingQuestionIds" type="list" />
            <dai:property name="lastVisitedAt" type="int" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_Message" name="Message" stepType="model" modelFormat="typescript"
        notes="Kilo-owned turn. role is user or assistant. Optional agent names which persona produced an assistant turn. Projected in the UI through assistant-ui / react-opencode — not a desktop table.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="id" type="str" />
            <dai:property name="role" type="str" />
            <dai:property name="agent" type="str" />
            <dai:property name="parts" type="list" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_Part" name="Part" stepType="model" modelFormat="typescript"
        notes="Kilo-owned typed content inside a message: text, tool, reasoning, and related OpenCode part types. Tool parts carry name and state and are what permission prompts attach to.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="type" type="str" />
            <dai:property name="toolName" type="str" />
            <dai:property name="state" type="str" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_Permission" name="Permission" stepType="model" modelFormat="typescript"
        notes="Kilo-owned tool-approval ask. Desktop copies pending ids into SessionActivity to drive Needs Attention. Events: permission.asked / permission.v2.*.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="id" type="str" />
            <dai:property name="sessionID" type="str" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_Question" name="Question" stepType="model" modelFormat="typescript"
        notes="Kilo-owned clarifying question. Desktop copies pending ids into SessionActivity. Events: question.asked / question.v2.*.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="id" type="str" />
            <dai:property name="sessionID" type="str" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_Attention" name="Attention State" stepType="model" modelFormat="plain"
        notes="Derived in the renderer, not stored. Values: Working, Approval, Input, Plan Ready, Failed, Done(unread). Computed from SessionActivity status + pending ids + lastVisitedAt.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="kind" type="str" />
            <dai:property name="kiloSessionId" type="str" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:sequenceFlow id="Flow_MetaOnKilo" sourceRef="Model_KiloDesktopMeta" targetRef="Model_KiloSession" name="stamped onto metadata.kilo-desktop" />
      <bpmn:sequenceFlow id="Flow_ActivityOnKilo" sourceRef="Model_SessionActivity" targetRef="Model_KiloSession" name="keyed by session id" />
      <bpmn:sequenceFlow id="Flow_SessionMsg" sourceRef="Model_KiloSession" targetRef="Model_Message" name="1..* messages" />
      <bpmn:sequenceFlow id="Flow_MsgPart" sourceRef="Model_Message" targetRef="Model_Part" name="1..* parts" />
      <bpmn:sequenceFlow id="Flow_SessionPerm" sourceRef="Model_KiloSession" targetRef="Model_Permission" name="0..* pending" />
      <bpmn:sequenceFlow id="Flow_SessionQ" sourceRef="Model_KiloSession" targetRef="Model_Question" name="0..* pending" />
      <bpmn:sequenceFlow id="Flow_SessionAttn" sourceRef="Model_SessionActivity" targetRef="Model_Attention" name="derives" />

    </bpmn:subProcess>

    <!-- ── Agent, provider, model ──────────────────────────────────────── -->

    <bpmn:subProcess id="Group_Runtime" name="Agent and model"
      notes="What runs a Kilo Session. The user picks an Agent and a Model per prompt; those choices live on the Kilo Session. Kilo owns catalogs and auth; the desktop owns the picker UI and local-model favorites.">

      <bpmn:task id="Model_Agent" name="Agent" stepType="model" modelFormat="typescript"
        notes="Persona/behavior for the session. Built-in switcher set: code (default), plan, ask, debug. Custom agents are markdown files at .kilo/agents/&lt;name&gt;.md (project) or ~/.config/kilo/agents/ (global). Hidden and deprecated agents are not selectable. Older alias: build → code.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="name" type="str" />
            <dai:property name="displayName" type="str" />
            <dai:property name="mode" type="str" />
            <dai:property name="hidden" type="bool" />
            <dai:property name="deprecated" type="bool" />
            <dai:property name="color" type="str" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_Provider" name="Provider" stepType="model" modelFormat="typescript"
        notes="A model source: Kilo Gateway, OpenAI, Anthropic, or the Anaconda local-inference provider. Connected state comes from Kilo auth plus desktop-owned API keys.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="id" type="str" />
            <dai:property name="name" type="str" />
            <dai:property name="connected" type="bool" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_Model" name="Model" stepType="model" modelFormat="typescript"
        notes="Selectable per session. Identity is the pair providerID/modelID (e.g. anthropic/claude-sonnet-4-6). Favorites persist in localStorage as kilo-ui.model-favorites:v1.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="providerID" type="str" />
            <dai:property name="modelID" type="str" />
            <dai:property name="displayName" type="str" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_LocalModel" name="Local Model" stepType="model" modelFormat="typescript"
        notes="User-registered GGUF file for on-device inference. Orthogonal to Workspace. Exposed to chat as provider ANACONDA_LOCAL_PROVIDER_ID. Persisted in the local-inference plugin KV registry.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="id" type="str" />
            <dai:property name="name" type="str" />
            <dai:property name="path" type="str" />
            <dai:property name="available" type="bool" />
            <dai:property name="addedAt" type="int" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:sequenceFlow id="Flow_ProvModel" sourceRef="Model_Provider" targetRef="Model_Model" name="1..* models" />
      <bpmn:sequenceFlow id="Flow_LocalProv" sourceRef="Model_LocalModel" targetRef="Model_Provider" name="appears as" />

    </bpmn:subProcess>

    <!-- ── Session artifacts ───────────────────────────────────────────── -->

    <bpmn:subProcess id="Group_Artifacts" name="Session artifacts"
      notes="Things a session opens or produces beside the transcript. Right-panel tabs are a UI composite keyed by sessionId (Plan, Files, Notebook, contributed tabs), persisted in localStorage kilo-ui:right-panel-state:v2 — not a domain aggregate of their own.">

      <bpmn:task id="Model_Plan" name="Plan" stepType="model" modelFormat="typescript"
        notes="Markdown plan the plan agent writes. UI: card plus right-panel Plan tab. File lives under the workspace matching .kilo/plans/*.md, .opencode/plans/*.md, plans/*.md, or .plans/*.md. Status writing | ready | error. Belongs to the session in the UI; belongs to the workspace on disk.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="path" type="str" />
            <dai:property name="markdown" type="str" />
            <dai:property name="status" type="str" />
            <dai:property name="anchorCallId" type="str" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_File" name="File" stepType="model" modelFormat="typescript"
        notes="Path under a workspace directory. Identity is (workspaceDirectory, relativePath) — not a database row. kind is text | image | unsupported. Writes use optimistic concurrency via expectedRevision (sha256). Opened in a session right-panel tab.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="workspaceDirectory" type="str" />
            <dai:property name="relativePath" type="str" />
            <dai:property name="kind" type="str" />
            <dai:property name="revision" type="str" />
            <dai:property name="byteLength" type="int" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_Notebook" name="Notebook" stepType="model" modelFormat="typescript"
        notes="Ephemeral nteract notebook in the chat right panel, shared live via runtimed. notebookId is a UUID; daemon notebook_id often equals the tab instance id. Optional path on disk when saved as .ipynb. Belongs to a Chat Session as a tab, not to a Workspace row.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="notebookId" type="str" />
            <dai:property name="sessionId" type="str" />
            <dai:property name="path" type="str" />
            <dai:property name="title" type="str" />
            <dai:property name="dirty" type="bool" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:sequenceFlow id="Flow_PlanFile" sourceRef="Model_Plan" targetRef="Model_File" name="stored as" />

    </bpmn:subProcess>

    <!-- ── Environment (orthogonal) ────────────────────────────────────── -->

    <bpmn:subProcess id="Group_Env" name="Environment"
      notes="Conda environment managed by the Environments plugin. Orthogonal to Workspace — v1 does not attach an environment to a workspace or session. Jobs are ephemeral queue items, not durable documents.">

      <bpmn:task id="Model_Environment" name="Environment" stepType="model" modelFormat="typescript"
        notes="A conda env identified by name + prefix (absolute path). Provider id is conda today; the contract is provider-agnostic so uv/pip can be added later.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="name" type="str" />
            <dai:property name="prefix" type="str" />
            <dai:property name="provider" type="str" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_Package" name="Package" stepType="model" modelFormat="typescript"
        notes="Installed package inside an environment. Specs on mutate are raw conda MatchSpec strings (e.g. numpy&gt;=1.24).">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="name" type="str" />
            <dai:property name="version" type="str" />
            <dai:property name="build" type="str" />
            <dai:property name="channel" type="str" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_Channel" name="Channel" stepType="model" modelFormat="plain"
        notes="Conda channel identifier: short name (conda-forge), URL, or file:// path.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="id" type="str" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:sequenceFlow id="Flow_EnvPkg" sourceRef="Model_Environment" targetRef="Model_Package" name="contains" />
      <bpmn:sequenceFlow id="Flow_PkgCh" sourceRef="Model_Package" targetRef="Model_Channel" name="from" />

    </bpmn:subProcess>

    <!-- ── Tools the agent can use ─────────────────────────────────────── -->

    <bpmn:subProcess id="Group_Ext" name="Skills and MCP"
      notes="External capabilities the agent loads. Configured in Kilo (global ~/.config/kilo or project .kilo), not as desktop database rows.">

      <bpmn:task id="Model_Skill" name="Skill" stepType="model" modelFormat="plain"
        notes="Task-specific instructions the agent loads when relevant. Project: .kilo/skills/&lt;name&gt;/. Global: ~/.kilo/skills/&lt;name&gt;/.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="name" type="str" />
            <dai:property name="scope" type="str" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_Mcp" name="MCP Server" stepType="model" modelFormat="plain"
        notes="External tool source under the mcp config key. Desktop-owned entries are written through kilo-server mcpConfig into app-owned Kilo config. MCP App is an HTML UI resource (text/html;profile=mcp-app) the session can open.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="id" type="str" />
            <dai:property name="uri" type="str" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:task id="Model_Marketplace" name="Marketplace Item" stepType="model" modelFormat="plain"
        notes="Installable agent, skill, or MCP server from the Kilo Marketplace catalog. Not a first-class desktop row; an install target.">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="kind" type="str" />
            <dai:property name="name" type="str" />
          </dai:properties>
        </bpmn:extensionElements>
      </bpmn:task>

      <bpmn:sequenceFlow id="Flow_MktSkill" sourceRef="Model_Marketplace" targetRef="Model_Skill" name="may install" />
      <bpmn:sequenceFlow id="Flow_MktMcp" sourceRef="Model_Marketplace" targetRef="Model_Mcp" name="may install" />

    </bpmn:subProcess>

    <!-- ── Relationships across aggregates ─────────────────────────────── -->

    <bpmn:sequenceFlow id="Flow_WsSession" sourceRef="Group_Workspace" targetRef="Group_Session" name="workspaceId stamped on Kilo metadata" />
    <bpmn:sequenceFlow id="Flow_SessionRuntime" sourceRef="Group_Session" targetRef="Group_Runtime" name="Kilo Session selects agent + model" />
    <bpmn:sequenceFlow id="Flow_SessionArtifacts" sourceRef="Group_Session" targetRef="Group_Artifacts" name="keyed by kiloSessionId" />
    <bpmn:sequenceFlow id="Flow_WsFile" sourceRef="Group_Workspace" targetRef="Group_Artifacts" name="files live under folders" />
    <bpmn:sequenceFlow id="Flow_RuntimeExt" sourceRef="Group_Runtime" targetRef="Group_Ext" name="agent loads" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_DomainModel">
    <bpmndi:BPMNPlane id="BPMNPlane_DomainModel" bpmnElement="Process_DomainModel">

      <bpmndi:BPMNShape id="Shape_Ctx_Language" bpmnElement="Ctx_Language">
        <dc:Bounds x="40" y="24" width="200" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Rule_NoProject" bpmnElement="Rule_NoProject">
        <dc:Bounds x="260" y="24" width="200" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Rule_SoftLink" bpmnElement="Rule_SoftLink">
        <dc:Bounds x="480" y="24" width="220" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Group_Workspace" bpmnElement="Group_Workspace" isExpanded="true">
        <dc:Bounds x="40" y="120" width="500" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Model_Workspace" bpmnElement="Model_Workspace">
        <dc:Bounds x="60" y="160" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Model_Folder" bpmnElement="Model_Folder">
        <dc:Bounds x="240" y="160" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Rule_OnePrimary" bpmnElement="Rule_OnePrimary">
        <dc:Bounds x="240" y="250" width="140" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Group_Session" bpmnElement="Group_Session" isExpanded="true">
        <dc:Bounds x="560" y="120" width="760" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Model_KiloSession" bpmnElement="Model_KiloSession">
        <dc:Bounds x="580" y="150" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Model_Message" bpmnElement="Model_Message">
        <dc:Bounds x="760" y="150" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Model_Part" bpmnElement="Model_Part">
        <dc:Bounds x="940" y="150" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Model_KiloDesktopMeta" bpmnElement="Model_KiloDesktopMeta">
        <dc:Bounds x="1120" y="150" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Model_SessionActivity" bpmnElement="Model_SessionActivity">
        <dc:Bounds x="580" y="250" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Model_Permission" bpmnElement="Model_Permission">
        <dc:Bounds x="760" y="250" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Model_Question" bpmnElement="Model_Question">
        <dc:Bounds x="940" y="250" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Model_Attention" bpmnElement="Model_Attention">
        <dc:Bounds x="1120" y="250" width="140" height="70" />
      </bpmndi:BPMNShape>

