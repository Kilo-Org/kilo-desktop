{
	"manifestVersion": 1,
	"id": "kilo.browser",
	"displayName": "Browser",
	"version": "1.0.0",
	"description": "Browse the web, and a workspace's HTML pages, in a session's panes.",
	"main": "./src/main/index.ts",
	"web": "./src/web/index.ts",
	"requires": {
		"kilo.core/tool": "optional",
		"kilo.work-sessions/workspaces": "optional",
		"kilo.work-sessions/work-sessions": "optional",
		"kilo.work-sessions/panes": "optional",
		"kilo.work-sessions/window": "optional",
		"kilo.work-sessions/pane-kind": "optional",
		"kilo.work-sessions/opener": "optional",
		"kilo.chat/markdown-extension": "optional"
	},
	"permissions": {
		"host": ["browser-host", "os"]
	},
	"objectTypes": [
		{
			"id": "page",
			"description": "The web page a Browser pane shows, keyed <workSessionId>/<paneId>."
		}
	],
	"domainObjects": [
		{
			"id": "pages",
			"home": "main",
			"description": "The web page each Browser pane shows: attaching its guest, navigation and page commands.",
			"objectType": "kilo.browser/page"
		}
	],
	"contributes": {
		"extensions": {
			"kilo.work-sessions/pane-kind": [
				{
					"id": "browser",
					"title": "Browser",
					"description": "Browse the web alongside this session.",
					"launch": {
						"newSession": true,
						"inSession": true
					},
					"keepAlive": true,
					"order": 60,
					"openCommand": "kilo.browser/open-browser",
					"availableWhen": {
						"all": ["kernel/desktop"]
					},
					"unavailableHint": "The browser is available in the desktop app."
				}
			],
			"kilo.work-sessions/opener": [
				{
					"id": "url",
					"match": {
						"type": "kilo.work-sessions/url"
					},
					"pane": "kilo.browser/browser"
				},
				{
					"id": "html-file",
					"match": {
						"type": "kilo.work-sessions/file",
						"pattern": "*.html"
					},
					"pane": "kilo.browser/browser"
				},
				{
					"id": "htm-file",
					"match": {
						"type": "kilo.work-sessions/file",
						"pattern": "*.htm"
					},
					"pane": "kilo.browser/browser"
				}
			],
			"kilo.chat/markdown-extension": [
				{
					"id": "web-links"
				}
			],
			"kilo.core/tool": [
				{
					"id": "open",
					"title": "Open web page",
					"external": false
				}
			],
			"kernel/command": [
				{
					"id": "open-browser",
					"title": "Open Browser",
					"category": "Tabs",
					"order": 42,
					"keybinding": "Mod+Shift+B",
					"when": {
						"all": ["kilo.work-sessions/paneTargetActive", "kernel/desktop"]
					}
				}
			],
			"kernel/telemetry-event": [
				{
					"id": "tab-opened",
					"name": "Browser Tab Opened"
				}
			]
		}
	}
}
