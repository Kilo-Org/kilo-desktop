{
	"name": "@anaconda-agentic-desktop/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Standalone React renderer for Anaconda Agentic Desktop",
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"sync:webmcp": "node scripts/sync-webmcp-assets.mjs",
		"predev": "pnpm run sync:webmcp",
		"dev": "vite",
		"prebuild": "pnpm run sync:webmcp",
		"build": "vite build",
		"test": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@anaconda-agentic-desktop/contracts": "workspace:*",
