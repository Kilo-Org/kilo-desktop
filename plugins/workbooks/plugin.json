{
	"manifestVersion": 1,
	"id": "kilo.workbooks",
	"displayName": "Workbooks",
	"version": "0.1.0",
	"description": "Workbooks: where what chats learn and decide about a piece of work is kept, created from workbook templates.",
	"main": "./src/main/index.ts",
	"web": "./src/web/index.ts",
	"requires": {
		"kilo.core/server": "optional",
		"kilo.work-sessions/workspaces": "optional",
		"kilo.work-sessions/work-sessions": "optional",
		"kilo.chat/composer": "optional",
		"kilo.core/tool": "optional",
		"kilo.work-sessions/work-session-action": "optional",
		"kilo.chat/tool-renderer": "optional",
		"kilo.work-sessions/new-work-session-setting": "optional",
		"kilo.core/chat-config": "optional"
	},
	"permissions": {
		"host": ["os"]
	},
	"extensionPoints": [
		{
			"id": "template",
			"kind": "additive",
			"description": "A workbook template offered when creating a workbook."
		}
	],
	"domainObjects": [
		{
			"id": "templates",
			"home": "main",
			"description": "The workbook templates on offer, and any skipped as invalid."
		},
		{
			"id": "workbooks",
			"home": "main",
			"description": "Every workspace's workbooks: their template and where each part lives in Pages."
		},
		{
			"id": "session-workbooks",
			"home": "main",
			"description": "Each work session's active workbook."
		}
	],
	"contributes": {
		"extensions": {
			"kilo.workbooks/template": [
				{
					"id": "coding"
				},
				{
					"id": "blank"
				}
			],
			"kernel/flag": [
				{
					"id": "workbooks",
					"description": "Shows Workbooks: start work sessions from a workbook, created from a workbook template.",
					"default": false
				}
			],
			"kilo.core/tool": [
				{
					"id": "read_workbook",
					"title": "Read the workbook",
					"readOnly": true,
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "add_item",
					"title": "Add an item to the workbook",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "add_task",
					"title": "Add a task to a plan step",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "set_task_done",
					"title": "Tick a plan step's task",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "set_status",
					"title": "Set a step's status or tick an item",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "edit_step",
					"title": "Edit a plan step",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "move_step",
					"title": "Move a plan step",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "remove_item",
					"title": "Remove an item from the workbook",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "supersede",
					"title": "Supersede a journal entry",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "answer_question",
					"title": "Answer an open question",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "write_section",
					"title": "Write a text section",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "hand_off",
					"title": "Hand off: update where we left off",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				},
				{
					"id": "set_activity",
					"title": "Say what you're working on",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				}
			],
			"kilo.work-sessions/work-session-action": [
				{
					"id": "workbook",
					"placement": "start",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				}
			],
			"kilo.chat/tool-renderer": [
				{
					"id": "receipts",
					"tools": [
						"kilo.workbooks/read_workbook",
						"kilo.workbooks/add_item",
						"kilo.workbooks/add_task",
						"kilo.workbooks/set_task_done",
						"kilo.workbooks/set_status",
						"kilo.workbooks/edit_step",
						"kilo.workbooks/move_step",
						"kilo.workbooks/remove_item",
						"kilo.workbooks/supersede",
						"kilo.workbooks/answer_question",
						"kilo.workbooks/write_section",
						"kilo.workbooks/hand_off",
						"kilo.workbooks/set_activity"
					],
					"standalone": true,
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				}
			],
			"kilo.work-sessions/new-work-session-setting": [
				{
					"id": "workbook",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				}
			],
			"kilo.core/chat-config": [
				{
					"id": "workbook",
					"when": {
						"all": ["kernel/flag:workbooks"]
					}
				}
			]
		}
	}
}
