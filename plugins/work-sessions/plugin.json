				},
				{
					"id": "delete-workspace",
					"title": "Delete workspace",
					"category": "Workspaces",
					"palette": false
				}
			],
			"kernel/flag": [
				{
					"id": "chat-layouts",
					"description": "Turns on layout presets: saving, applying and defaulting pane layouts from an open session's header.",
					"default": false
				}
			],
			"kernel/telemetry-event": [
				{
					"id": "workspace-created",
					"name": "Workspace Created"
				},
