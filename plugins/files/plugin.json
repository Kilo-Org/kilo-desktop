{
	"manifestVersion": 1,
	"id": "kilo.files",
	"displayName": "Files",
	"version": "1.0.0",
	"description": "Browse, edit and mention the files in a session's workspace folders.",
	"main": "./src/main/index.ts",
	"web": "./src/web/index.ts",
	"requires": {
		"kilo.core/tool": "optional",
		"kilo.work-sessions/workspaces": "optional",
		"kilo.work-sessions/file-watcher": "optional",
		"kilo.work-sessions/vcs": "optional",
		"kilo.work-sessions/work-sessions": "optional",
		"kilo.work-sessions/panes": "optional",
		"kilo.work-sessions/window": "optional",
		"kilo.work-sessions/pane-kind": "optional",
		"kilo.work-sessions/opener": "optional",
		"kilo.chat/composer-mention": "optional",
		"kilo.shell/theme": "optional"
	},
	"domainObjects": [
		{
			"id": "documents",
			"home": "main",
			"description": "Listing, reading and saving files inside workspace folders."
		}
	],
	"contributes": {
		"extensions": {
			"kernel/command": [
				{
					"id": "open",
					"title": "Open Files",
					"category": "Files",
					"order": 10,
					"keybinding": "Mod+Shift+E",
					"when": {
						"all": ["kilo.work-sessions/paneTargetActive"]
					}
				}
			],
			"kilo.work-sessions/pane-kind": [
				{
					"id": "files",
					"title": "Files",
					"description": "Browse and edit files in this session's workspace.",
					"launch": {
						"newSession": true,
						"inSession": true
					},
					"layoutKind": "document",
					"order": 70,
					"openCommand": "kilo.files/open"
				}
			],
			"kilo.work-sessions/opener": [
				{
					"id": "file",
					"match": {
						"type": "kilo.work-sessions/file"
					},
					"pane": "kilo.files/files",
					"priority": -100
				}
			],
			"kilo.chat/composer-mention": [
				{
					"id": "files",
					"trigger": "@",
					"title": "Files"
				}
			],
			"kilo.core/tool": [
				{
					"id": "open",
					"title": "Open file",
					"external": false
				}
			],
			"kernel/telemetry-event": [
				{
					"id": "file-opened",
					"name": "File Opened"
				},
				{
					"id": "notebook-opened",
					"name": "Notebook Opened"
				}
			]
		}
	}
}
