{
	"name": "@kilo-desktop/desktop",
	"version": "0.1.12",
	"private": true,
	"type": "module",
	"description": "Electron shell for Kilo Desktop",
	"productName": "Kilo",
	"author": "Anaconda, Inc.",
	"license": "UNLICENSED",
	"homepage": "https://kilo.ai",
	"main": ".vite/build/main.js",
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"prestart": "pnpm run prepare:plugins",
		"premake": "pnpm run prepare:build",
		"prepackage": "pnpm run prepare:build",
		"prepublish": "tsx config/preflight-publish.ts && pnpm run prepare:build",
		"prepare:build": "pnpm run prepare:web && pnpm run prepare:plugins",
		"prepare:web": "pnpm --filter @kilo-desktop/web build && node --input-type=module -e \"import { access } from 'node:fs/promises'; await access(new URL('../web/dist/index.html', import.meta.url));\"",
		"prepare:plugins": "pnpm --filter \"@kilo-desktop/plugin-*\" -r --if-present run prepare-assets",
		"make": "tsx config/run-packaging.ts make",
		"package": "tsx config/run-packaging.ts package",
		"package:e2e": "cross-env ELECTRON_ENABLE_INSPECT=true ELECTRON_SKIP_NATIVE_REBUILD=true VITE_FEATURE_FLAG_OVERRIDES=chat-layouts,update-track-switcher,external-api-apps-settings,workspace-board,searchbar-windows-panels VITE_KILO_E2E_AUTH=1 pnpm run package",
		"publish": "tsx config/run-packaging.ts publish",
		"release:smoke": "tsx config/smoke-release-artifact.ts",
		"start": "electron-forge start -- --remote-debugging-port=9222",
		"test": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"dependencyNotes": {
		"ws": "PACKAGING BRIDGE: Vite leaves `ws` external in the main bundle (CJS `events` require). pnpm deploy only hoists packages declared on desktop, so a transitive kilo-server dep is not enough.",
		"koffi": "PACKAGING BRIDGE: Vite leaves `koffi` external in the main bundle (dynamic import in the notebook daemon peer-credential check). pnpm deploy only hoists packages declared on desktop, so a transitive notebook dep is not enough; declaring it here ships koffi and its prebuilt `@koromix/koffi-*` sibling in the packaged app. Keep in sync with plugins/notebook."
	},
	"dependencies": {
		"@kilo-desktop/contracts": "workspace:*",
		"@kilo-desktop/feature-sdk": "workspace:*",
		"@kilo-desktop/plugin-browser": "workspace:*",
		"@kilo-desktop/plugin-environments": "workspace:*",
		"@kilo-desktop/plugin-files": "workspace:*",
		"@kilo-desktop/plugin-git": "workspace:*",
		"@kilo-desktop/plugin-kilo-marketplace": "workspace:*",
		"@kilo-desktop/plugin-kilo-server": "workspace:*",
		"@kilo-desktop/plugin-kilo-ui": "workspace:*",
		"@kilo-desktop/plugin-local-inference": "workspace:*",
		"@kilo-desktop/plugin-notebook": "workspace:*",
		"@kilo-desktop/plugin-terminal": "workspace:*",
		"@kilo-desktop/plugin-todos": "workspace:*",
		"@github/keytar": "^7.10.6",
		"@launchdarkly/node-client-sdk": "^4.0.0",
		"@parcel/watcher": "^2.6.0",
		"@runtimed/node": "0.6.1-nightly.37598349389",
		"@sentry/electron": "catalog:",
		"@vscode/proxy-agent": "^0.45.0",
		"atomically": "catalog:",
		"electron-debug": "^5.0.0",
		"electron-log": "catalog:",
		"electron-squirrel-startup": "^1.0.1",
		"electron-store": "^11.0.2",
		"execa": "catalog:",
		"koffi": "3.3.3",
		"lodash": "catalog:",
		"openid-client": "^6.6.3",
		"p-defer": "^4.0.1",
		"p-limit": "catalog:",
		"semver": "catalog:",
		"shell-env": "^4.0.3",
		"smol-toml": "^1.3.1",
		"ws": "^8.21.3",
		"zod": "catalog:"
	},
	"optionalDependencies": {
		"@runtimed/node-win32-arm64-msvc": "0.6.1-nightly.37598349389"
	},
	"devDependencies": {
		"@kilo-desktop/testing": "workspace:*",
		"@kilo-desktop/vite-plugin-externalize-deps": "workspace:*",
		"@electron-forge/cli": "8.0.1",
		"@electron-forge/maker-deb": "8.0.1",
		"@electron-forge/maker-dmg": "8.0.1",
		"@electron-forge/maker-squirrel": "8.0.1",
		"@electron-forge/maker-zip": "8.0.1",
		"@electron-forge/plugin-fuses": "8.0.1",
		"@electron-forge/plugin-vite": "8.0.1",
		"@electron-forge/publisher-s3": "8.0.1",
		"@electron-forge/shared-types": "8.0.1",
		"@electron/fuses": "^2.0.0",
		"@playwright/test": "catalog:",
		"@sentry/vite-plugin": "catalog:",
		"@types/electron-squirrel-startup": "1.0.2",
		"@types/lodash": "^4.17.20",
		"@types/node": "^24.13.3",
		"@types/semver": "^7.8.0",
		"@vitest/coverage-v8": "catalog:",
		"cross-env": "^10.1.0",
		"electron": "catalog:",
		"electron-winstaller": "5.4.4",
		"playwright": "catalog:",
		"tsx": "^4.23.1",
		"type-fest": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
