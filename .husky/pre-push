# Mirror CI checks locally.
# Lint + format run in parallel with turbo check + test.
# --affected scopes turbo to packages changed since origin/main;
# turbo caching skips unchanged tasks within those packages.
pnpm lint &
LINT_PID=$!
pnpm format:check &
FMT_PID=$!

pnpm turbo run check test --affected --output-logs=errors-only &
TURBO_PID=$!

FAILED=0
wait $LINT_PID  || FAILED=1
wait $FMT_PID   || FAILED=1
wait $TURBO_PID || FAILED=1
exit $FAILED
