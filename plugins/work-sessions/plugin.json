					"title": "Go to last tab",
					"category": "Tabs",
					"order": 9,
					"palette": false,
					"keybinding": "Mod+9",
					"when": {
						"all": ["kilo.work-sessions/workSessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "open-work-session",
					"title": "Open session",
					"category": "Sessions",
					"palette": false
				},
				{
					"id": "show-work-sessions-view",
					"title": "Show sessions view",
					"category": "Sessions",
					"palette": false
				},
				{
					"id": "add-workspace",
					"title": "Add workspace",
					"category": "Workspaces",
					"order": 10,
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "open-folder",
					"title": "Open folder…",
					"category": "Workspaces",
					"order": 15,
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "manage-workspaces",
					"title": "Manage workspaces",
					"category": "Workspaces",
					"order": 20,
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "edit-workspace",
					"title": "Edit workspace",
					"category": "Workspaces",
