{
	"name": "@kilo-desktop/plugin-core-v2",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "kilo.core for the Kilo Code v2 server line: a copy of @kilo-desktop/plugin-core with the same plugin id and contracts, chosen at build time (docs/adr/003-kilo-server-line.md)",
	"author": "Anaconda, Inc.",
	"license": "SEE LICENSE IN ../../LICENSE.md",
	"exports": {
		"./plugin.json": "./plugin.json",
		"./main": "./src/main/index.ts",
		"./contracts": "./src/contracts/index.ts",
		"./cli-distribution": "./src/main/agent/cli-distribution/index.ts"
	},
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"fetch-cli": "tsx scripts/fetch-cli.ts",
		"prepare-assets": "pnpm run fetch-cli",
		"test": "vitest run",
		"test:platform": "vitest run --project integration",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@kilo-desktop/kernel": "workspace:*",
		"@kilo-desktop/plugin-core": "workspace:*",
		"@kilocode/client": "0.0.0-v2-239",
		"@opencode/schema": "npm:@kilocode/schema@0.0.0-v2-239",
		"@launchdarkly/node-client-sdk": "^4.4.4",
		"@modelcontextprotocol/server": "2.4.0",
		"atomically": "catalog:",
		"effect": "4.1.0",
		"execa": "catalog:",
		"jsonc-parser": "^3.3.1",
		"lodash": "catalog:",
		"zod": "catalog:"
	},
	"optionalDependencies": {
		"@kilocode/cli-darwin-arm64": "0.0.0-v2-239",
		"@kilocode/cli-linux-arm64": "0.0.0-v2-239",
		"@kilocode/cli-linux-x64-baseline": "0.0.0-v2-239",
		"@kilocode/cli-windows-arm64": "0.0.0-v2-239",
		"@kilocode/cli-windows-x64-baseline": "0.0.0-v2-239"
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "^2.0.0",
		"@types/lodash": "^4.17.20",
		"@types/node": "^26.0.0",
		"@types/react": "^19.2.17",
		"@vitest/coverage-v8": "catalog:",
		"tsx": "^4.23.15",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
