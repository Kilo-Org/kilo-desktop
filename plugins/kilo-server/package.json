{
	"name": "@kilo-desktop/plugin-kilo-server",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Kilo CLI packaging and server lifecycle",
	"exports": {
		"./plugin.json": "./plugin.json",
		"./main": "./src/main/index.ts",
		"./web": "./src/web/index.ts",
		"./contracts": "./src/contracts/schemas.ts",
		"./cli-distribution": "./src/main/cli-distribution/index.ts",
		"./packaged-assets": "./src/main/resolve-plugin-asset.ts"
	},
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"fetch-cli": "tsx scripts/fetch-cli.ts",
		"prepare-assets": "pnpm run fetch-cli",
		"test": "vitest run",
		"test:platform": "vitest run --project integration",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@kilo-desktop/feature-sdk": "workspace:*",
