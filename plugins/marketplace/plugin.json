{
	"manifestVersion": 1,
	"id": "kilo.marketplace",
	"displayName": "Kilo Marketplace",
	"version": "1.0.0",
	"description": "Browse and install agents, skills, and MCP servers into Kilo.",
	"main": "./src/main/index.ts",
	"web": "./src/web/index.ts",
	"requires": {
		"kilo.core/server": "optional",
		"kilo.core/mcp-server": "optional",
		"kilo.work-sessions/workspaces": "optional",
		"kilo.chat/composer": "optional",
		"kilo.shell/settings-section": "optional"
	},
	"permissions": {
		"host": ["clipboard", "os"]
	},
	"domainObjects": [
		{
			"id": "marketplace",
			"home": "main",
			"description": "Kilo's Marketplace across the app's workspaces: list, preview, install, remove, MCP sign-in and launch-command checks."
		}
	],
	"contributes": {
		"extensions": {
			"kilo.shell/settings-section": [
				{
					"id": "kilo-marketplace",
					"title": "Agent Behavior",
					"description": "Manage the agents, skills, and MCPs available to Kilo.",
					"category": "kilo.shell/ai",
					"priority": 100
				}
			],
			"kernel/telemetry-event": [
				{
					"id": "marketplace-tab-viewed",
					"name": "Marketplace Tab Viewed"
				},
				{
					"id": "marketplace-install-clicked",
					"name": "Marketplace Install Button Clicked"
				},
				{
					"id": "marketplace-item-installed",
					"name": "Marketplace Item Installed"
				},
				{
					"id": "marketplace-item-removed",
					"name": "Marketplace Item Removed"
				}
			]
		}
	}
}
