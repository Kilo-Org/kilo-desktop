# Public OAuth client ID for Preview builds. OAuth client IDs are not secrets.
VITE_AUTH_CLIENT_ID=a2de2b01-8b4f-4134-b73d-981473d32f11
VITE_LAUNCHDARKLY_CLIENT_SIDE_ID=6a7b2d80efc2840af1a3c9e5
# Sentry reporting is disabled for Preview builds.
VITE_SENTRY_DSN=

# Telemetry (OTEL logging) - preview. Production endpoints tagged `test` keep
# Preview events separable from production data.
VITE_ANACONDA_LOGGING_AUTH_URL='https://metrics.oauth.anaconda.com/v1/logs'
VITE_ANACONDA_LOGGING_NON_AUTH_URL='https://public.telemetry.anaconda.com/v1/logs'
VITE_ANACONDA_LOGGING_EXPORT_INTERVAL_MS=15000
VITE_ANACONDA_LOGGING_ENV_ATTRIBUTE='test'
