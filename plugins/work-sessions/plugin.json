{
	"manifestVersion": 1,
	"id": "kilo.work-sessions",
	"displayName": "Work sessions",
	"version": "1.0.0",
	"description": "Workspaces, work sessions and their panes, and everything the user sees of them: workspace management, the session list, the canvas and the New Session page.",
	"main": "./src/main/index.ts",
	"web": "./src/web/index.ts",
	"requires": {
		"kilo.core/chats": "optional",
		"kilo.core/server": "optional",
		"kilo.shell/main": "optional",
		"kilo.shell/top-bar-title": "optional",
		"kilo.shell/top-bar-action": "optional",
		"kilo.shell/status-bar-item": "optional",
		"kilo.shell/left-sidebar": "optional",
		"kilo.shell/dialog": "optional",
		"kilo.shell/onboarding-step": "optional",
		"kilo.shell/settings-section": "optional",
		"kilo.shell/menu-item": "optional",
		"kilo.shell/navigation": "optional",
		"kilo.shell/notifications": "optional",
		"kernel/windows": "optional",
		"kernel/notifications": "optional",
		"kernel/keybindings": "optional"
	},
	"permissions": {
		"host": ["dialogs", "windows", "notifications"]
	},
	"contextKeys": [
		{
			"id": "hasWorkspaces",
			"scope": "global",
			"description": "True while at least one workspace exists."
		},
		{
			"id": "hasVcs",
			"scope": "global",
			"description": "True while a version control contribution (kilo.work-sessions/vcs) is present."
		},
		{
			"id": "workSessionActive",
			"scope": "window",
			"description": "True while a work session is open in this window."
		},
		{
			"id": "workSessionsViewShown",
			"scope": "window",
			"description": "True while a work sessions view (kilo.work-sessions/sessions-view) fills this window's main area."
		},
		{
			"id": "workspaceActive",
			"scope": "window",
			"description": "True while the session list is focused on one workspace."
		},
		{
			"id": "paneTargetActive",
			"scope": "window",
			"description": "True while opening a pane has somewhere to go: an open session, or the New Session page, which starts a session with it."
		}
	],
	"objectTypes": [
		{
			"id": "workspace",
			"description": "A workspace: a named project of one or more folders, keyed by its id."
		},
		{
			"id": "work-session",
			"description": "A work session: a workspace, where it works and the chats it holds, keyed by its id."
		},
		{
			"id": "pane",
			"description": "A pane open in a work session, keyed <workSessionId>/<paneId>."
		},
		{
			"id": "file",
			"description": "A file or folder, keyed by its absolute path."
		},
		{
			"id": "url",
			"description": "A web page, keyed by its URL."
		}
	],
	"domainObjects": [
		{
			"id": "workspaces",
			"home": "main",
			"description": "Workspaces, the active one, folder availability and path authorisation.",
			"objectType": "kilo.work-sessions/workspace"
		},
		{
			"id": "file-watcher",
			"home": "main",
			"description": "Watched workspace folders and the file changes in them."
		},
		{
			"id": "work-sessions",
			"home": "main",
			"description": "Every work session: create, rename, pin, archive and delete, and the chats it holds.",
			"objectType": "kilo.work-sessions/work-session"
		},
		{
			"id": "panes",
			"home": "main",
			"description": "The panes open in every work session, their layout and arrangement.",
			"objectType": "kilo.work-sessions/pane"
		},
		{
			"id": "window",
			"home": "renderer",
			"description": "This window's view of the work sessions: focused workspace, open work session or work sessions view, and opening panes."
		},
		{
			"id": "layout-presets",
			"home": "main",
			"description": "Saved layout presets and the default one."
		}
	],
	"extensionPoints": [
		{
			"id": "vcs",
			"kind": "exclusive",
			"description": "Version control for workspace folders: status, branches and the isolated copies work sessions run in."
		},
		{
			"id": "opener",
			"kind": "additive",
			"description": "Opens an object (a file, a URL) in a pane kind."
		},
		{
			"id": "pane-kind",
			"kind": "additive",
			"description": "A kind of pane a work session can hold."
		},
		{
			"id": "work-session-menu",
			"kind": "additive",
			"description": "An item in a work session's menu."
		},
		{
			"id": "work-session-decoration",
			"kind": "additive",
			"description": "A badge or hover detail shown with a work session."
		},
		{
			"id": "work-session-facet",
			"kind": "additive",
			"description": "Read-only facts about work sessions the session list filters by."
		},
		{
			"id": "work-sessions-view",
			"kind": "additive",
			"description": "Another view of the work sessions, shown in place of the open work session."
		},
		{
			"id": "work-session-action",
			"kind": "additive",
			"description": "A button in an open work session's header."
		},
		{
			"id": "work-session-list-action",
			"kind": "additive",
			"description": "A button in the session list's header."
		},
		{
			"id": "new-work-session-option",
			"kind": "additive",
			"description": "A choice on the New Session page, beside where the session runs."
		},
		{
			"id": "work-session-starter",
			"kind": "exclusive",
			"description": "The New Session page's body: how a person starts a session."
		},
		{
			"id": "permission-auto-answer",
			"kind": "additive",
			"description": "Whether a plugin answers an agent permission request for the person."
		}
	],
	"contributes": {
		"extensions": {
			"kilo.shell/main": [
				{
					"id": "work-sessions"
				}
			],
			"kilo.shell/top-bar-title": [
				{
					"id": "session-title",
					"when": {
						"all": ["kilo.work-sessions/workSessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "view-title",
					"when": {
						"all": ["kilo.work-sessions/workSessionsViewShown"],
						"none": ["kernel/secondaryWindow"]
					}
				}
			],
			"kilo.shell/status-bar-item": [
				{
					"id": "design-review",
					"title": "Design review",
					"kind": "view"
				}
			],
			"kilo.shell/top-bar-action": [
				{
					"id": "session-actions",
					"when": {
						"all": ["kilo.work-sessions/workSessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "view-actions",
					"when": {
						"all": ["kilo.work-sessions/workSessionsViewShown"],
						"none": ["kernel/secondaryWindow"]
					}
				}
			],
			"kilo.shell/left-sidebar": [
				{
					"id": "work-sessions"
				}
			],
			"kilo.shell/dialog": [
				{
					"id": "workspace-dialogs",
					"title": "Workspaces"
				}
			],
			"kilo.shell/onboarding-step": [
				{
					"id": "workspace",
					"label": "Workspace",
					"priority": 700,
					"showWhen": {
						"none": ["kilo.work-sessions/hasWorkspaces"]
					}
				}
			],
			"kilo.shell/settings-section": [
				{
					"id": "notifications",
					"title": "Notifications",
					"description": "A sound, plus a system notification while Kilo is in the background. “When I'm not looking” skips the session you have open.",
					"priority": 72
				}
			],
			"kilo.shell/menu-item": [
				{
					"id": "new-work-session",
					"command": "kilo.work-sessions/new-work-session",
					"menu": "file",
					"group": "session",
					"priority": 30
				},
				{
					"id": "new-pane",
					"command": "kilo.work-sessions/new-pane",
					"menu": "file",
					"group": "tab",
					"priority": 20
				},
				{
					"id": "close-pane",
					"command": "kilo.work-sessions/close-pane",
					"menu": "file",
					"group": "tab",
					"priority": 10
				}
			],
			"kernel/window-view": [
				{
					"id": "pane",
					"title": "Pane",
					"width": 720,
					"height": 720
				},
				{
					"id": "work-sessions-view",
					"title": "Sessions",
					"width": 1240,
					"height": 760
				}
			],
			"kernel/service": [
				{
					"id": "file-watcher",
					"title": "Workspace file watcher",
					"kind": "daemon",
					"startOn": "window-shown",
					"restart": {
						"policy": "never"
					}
				}
			],
			"kernel/command": [
				{
					"id": "new-work-session",
					"title": "New session",
					"category": "Sessions",
					"order": 30,
					"keybinding": [
						{
							"mac": "Mod+N",
							"default": "Ctrl+Shift+N"
						},
						"Mod+Shift+O"
					],
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "new-empty-work-session",
					"title": "New empty session",
					"category": "Sessions",
					"order": 31,
					"when": {
						"all": ["kilo.work-sessions/paneTargetActive"],
						"none": ["kilo.work-sessions/workSessionActive"]
					}
				},
				{
					"id": "search-work-sessions",
					"title": "Search sessions and workspaces",
					"category": "Sessions",
					"order": 0,
					"keybinding": {
						"mac": "Mod+K",
						"default": "Ctrl+Shift+K"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "next-work-session",
					"title": "Next session",
					"category": "Sessions",
					"order": 20,
					"keybinding": [
						"Ctrl+Tab",
						{
							"mac": "Mod+Alt+ArrowDown",
							"default": "Alt+ArrowDown"
						}
					],
					"repeatable": true,
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "previous-work-session",
					"title": "Previous session",
					"category": "Sessions",
					"order": 21,
					"keybinding": [
						"Ctrl+Shift+Tab",
						{
							"mac": "Mod+Alt+ArrowUp",
							"default": "Alt+ArrowUp"
						}
					],
					"repeatable": true,
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "next-attention-work-session",
					"title": "Go to next session that needs attention",
					"category": "Sessions",
					"order": 22,
					"keybinding": {
						"mac": "Mod+Alt+A",
						"default": "Ctrl+Shift+A"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "toggle-pin-work-session",
					"title": "Pin or unpin session",
					"category": "Sessions",
					"order": 31,
					"keybinding": {
						"mac": "Mod+Alt+P",
						"default": "Ctrl+Alt+P"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "work-session-1",
					"title": "Go to session 1",
					"category": "Sessions",
					"order": 1,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+1",
						"default": "Alt+1"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "work-session-2",
					"title": "Go to session 2",
					"category": "Sessions",
					"order": 2,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+2",
