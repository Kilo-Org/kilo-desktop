# Fast local gate: lint, format and typecheck in parallel (~2-3 s).
# Tests stay in CI (and `pnpm test:changed` locally) because they took ~70 s of
# an ~80 s hook. CI repeats every check here, so `--no-verify` cannot let
# anything through unchecked.
# `check:fast` typechecks every tsconfig through Oxlint's tsrs backend in one
# process; CI's `typecheck` job keeps `tsc` as the gate.
pnpm lint &
LINT_PID=$!
pnpm format:check &
FMT_PID=$!
pnpm check:fast &
TYPES_PID=$!

FAILED=0
wait $LINT_PID  || FAILED=1
wait $FMT_PID   || FAILED=1
wait $TYPES_PID || FAILED=1
exit $FAILED
