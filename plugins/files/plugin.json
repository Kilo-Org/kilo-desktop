{
	"manifestVersion": 1,
	"id": "kilo.files",
	"displayName": "Files",
	"version": "1.0.0",
	"description": "Browse, edit and mention the files in a session's workspace folders.",
	"requires": {
		"kilo.workspaces/workspace": "optional",
		"kilo.workspaces/file": "optional",
		"kilo.workspaces/vcs": "optional",
		"kilo.sessions/session": "optional",
		"kilo.sessions/pane": "optional",
		"kilo.sessions/opener": "optional",
		"kilo.chat/composer-mention": "optional",
		"kilo.chat/markdown-extension": "optional",
		"kilo.agent/tool": "optional",
		"kilo.shell/theme": "optional",
		"kilo.flags/flags": "optional",
		"kilo.telemetry/telemetry": "optional",
		"kilo.telemetry/telemetry-event": "optional",
		"kilo.workbench/pane-launcher": "optional"
	},
	"domains": [
		{
			"id": "documents",
			"home": "main",
			"description": "Listing, reading and saving files inside workspace folders."
		}
	],
	"contributes": {
		"extensions": {
			"kernel/command": [
				{
					"id": "open",
					"title": "Open Files",
					"category": "Files",
					"order": 10,
					"keybinding": "Mod+Shift+E",
					"when": {
						"all": ["kilo.workbench/sessionActive"]
					}
				}
			],
			"kilo.sessions/pane": [
				{
					"id": "files",
					"title": "Files",
					"description": "Browse and edit files in this session's workspace.",
					"launch": {
						"newSession": true,
						"inSession": true
					},
					"layoutKind": "document",
					"order": 40
				}
			],
			"kilo.sessions/opener": [
				{
					"id": "file",
					"match": {
						"type": "kilo.workspaces/file"
					},
					"pane": "kilo.files/files",
					"priority": -100
				}
			],
			"kilo.chat/composer-mention": [
				{
					"id": "files",
					"trigger": "@",
					"title": "Files"
				}
			],
			"kilo.chat/markdown-extension": [
				{
					"id": "file-links"
				}
			],
			"kilo.agent/tool": [
				{
					"id": "open",
					"title": "Open file",
					"external": false
				}
			],
			"kilo.telemetry/telemetry-event": [
				{
					"id": "file-opened",
					"name": "File Opened"
				},
				{
					"id": "notebook-opened",
					"name": "Notebook Opened"
				}
			]
		}
	}
}
