{
	"name": "@anaconda-agentic-desktop/e2e",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Playwright/Electron e2e suite for Anaconda Agentic Desktop",
	"exports": {
		".": "./index.ts",
		"./fixtures": "./fixtures/shell.ts"
	},
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
