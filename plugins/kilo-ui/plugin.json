{
	"id": "kilo-ui",
	"displayName": "Kilo UI",
	"version": "1.0.0",
	"main": "./src/main/index.ts",
	"web": "./src/web/index.ts",
	"contributes": {
		"providers": [
			{ "component": "WorkspacesFeatureProvider", "priority": 20 },
			{ "component": "ChatFeatureProvider", "priority": 10 }
		],
		"routes": [{ "path": "/chat", "component": "ChatPage", "title": "Chat" }],
		"nav": [],
		"zones": [
			{
				"zone": "sidebar",
				"component": "ThreadList",
				"label": "Chats",
				"priority": 10
			}
		]
	}
}
