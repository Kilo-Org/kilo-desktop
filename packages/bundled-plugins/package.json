		"@kilo-desktop/plugin-notebook": "workspace:*",
		"@kilo-desktop/plugin-shell": "workspace:*",
		"@kilo-desktop/plugin-terminal": "workspace:*",
		"@kilo-desktop/plugin-work-sessions": "workspace:*",
		"@kilo-desktop/plugin-workbooks": "workspace:*",
