				},
				{
					"id": "work-session-3",
					"title": "Go to session 3",
					"category": "Sessions",
					"order": 3,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+3",
						"default": "Alt+3"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "work-session-4",
					"title": "Go to session 4",
					"category": "Sessions",
					"order": 4,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+4",
						"default": "Alt+4"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "work-session-5",
					"title": "Go to session 5",
					"category": "Sessions",
					"order": 5,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+5",
						"default": "Alt+5"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
