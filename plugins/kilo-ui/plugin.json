{
	"id": "kilo-ui",
	"displayName": "Kilo UI",
	"version": "1.0.0",
	"main": "./src/main/index.ts",
	"web": "./src/web/index.ts",
	"contributes": {
		"providers": [
			{ "component": "WorkspacesFeatureProvider", "priority": 20 },
			{ "component": "ChatFeatureProvider", "priority": 10 },
			{ "component": "OnboardingProvider", "priority": 5 }
		],
		"routes": [
			{
				"path": "/chat",
				"component": "ChatPage",
				"title": "Chat",
				"surface": "transparent"
			}
		],
		"nav": [],
		"zones": [
			{
				"zone": "sidebar",
				"component": "SessionList",
				"label": "Chats",
				"priority": 10
			}
		],
		"settings": [
			{
				"id": "kilo-account",
				"title": "Kilo",
				"component": "KiloAccountSettings",
				"icon": "KiloAccountNavIcon",
				"priority": 90
			}
		]
	}
}
