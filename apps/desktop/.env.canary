# Public OAuth client ID for Canary builds. OAuth client IDs are not secrets.
VITE_AUTH_CLIENT_ID=a2de2b01-8b4f-4134-b73d-981473d32f11
VITE_LAUNCHDARKLY_CLIENT_SIDE_ID=6a7b2d470f04420a5d0d5f12
# Sentry reporting is disabled for canary.
VITE_SENTRY_DSN=

# Telemetry (OTEL logging) — canary. Staging endpoints + a distinct env
# attribute so canary data is separable from prod.
VITE_ANACONDA_LOGGING_AUTH_URL='https://metrics.oauth.anaconda.com/v1/logs'
VITE_ANACONDA_LOGGING_NON_AUTH_URL='https://public.telemetry.anaconda.com/v1/logs'
VITE_ANACONDA_LOGGING_EXPORT_INTERVAL_MS=15000
VITE_ANACONDA_LOGGING_ENV_ATTRIBUTE='staging'
