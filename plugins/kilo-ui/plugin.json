{
	"id": "kilo-ui",
	"displayName": "Kilo UI",
	"version": "1.0.0",
	"main": "./src/main/index.ts",
	"web": "./src/web/index.ts",
	"zones": [{ "id": "chat-right-panel-tab" }, { "id": "chat-markdown-extension" }],
	"contributes": {
		"providers": [
			{ "component": "WorkspacesFeatureProvider", "priority": 20 },
			{ "component": "ChatFeatureProvider", "priority": 10 },
			{ "component": "OnboardingProvider", "priority": 5 }
		],
		"routes": [
			{
				"path": "/chat",
				"component": "ChatPage",
				"title": "Chat",
				"surface": "transparent",
				"header": {
					"leading": "ChatPageHeaderLeading",
					"actions": "ChatPageHeaderActions"
				}
			}
		],
		"nav": [],
		"zones": [
			{
				"zone": "sidebar",
				"component": "SessionList",
				"label": "Chats",
				"priority": 10
			},
			{
				"zone": "sidebar-header-actions",
				"component": "SessionListHeaderSearch",
				"label": "Search chats and workspaces",
				"priority": 10
			}
		],
		"settings": [
			{
				"id": "kilo-providers",
				"title": "AI Providers",
				"component": "KiloProvidersSettings",
				"icon": "KiloProvidersNavIcon",
				"category": "AI",
				"priority": 90
			}
		]
	}
}
