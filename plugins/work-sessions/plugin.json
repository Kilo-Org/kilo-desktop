					}
				},
				{
					"id": "work-session-last",
					"title": "Go to last session",
					"category": "Sessions",
					"order": 9,
					"palette": false,
					"keybinding": {
						"mac": "Ctrl+9",
						"default": "Alt+9"
					},
					"when": {
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "new-pane",
					"title": "New tab",
					"category": "Tabs",
					"order": 30,
					"keybinding": {
						"mac": "Mod+T",
						"default": "Ctrl+Shift+T"
					},
					"when": {
						"all": ["kilo.work-sessions/workSessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "close-pane",
					"title": "Close tab",
					"category": "Tabs",
					"order": 31,
					"keybinding": {
						"mac": "Mod+W",
						"default": "Ctrl+Shift+W"
					},
					"when": {
						"all": ["kilo.work-sessions/workSessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "new-group-right",
					"title": "New group to the right",
					"category": "Tabs",
					"order": 32,
					"keybinding": {
						"mac": "Mod+\\",
						"default": "Ctrl+Shift+\\"
					},
					"when": {
						"all": ["kilo.work-sessions/workSessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "new-group-below",
					"title": "New group below",
					"category": "Tabs",
					"order": 33,
					"keybinding": {
						"mac": "Alt+Mod+\\",
						"default": "Ctrl+Alt+Shift+\\"
					},
					"when": {
						"all": ["kilo.work-sessions/workSessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "next-pane",
					"title": "Next tab",
					"category": "Tabs",
					"order": 20,
					"repeatable": true,
					"keybinding": {
						"mac": "Mod+Alt+ArrowRight",
						"default": "Ctrl+PageDown"
					},
					"when": {
						"all": ["kilo.work-sessions/workSessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "previous-pane",
					"title": "Previous tab",
					"category": "Tabs",
					"order": 21,
					"repeatable": true,
					"keybinding": {
						"mac": "Mod+Alt+ArrowLeft",
						"default": "Ctrl+PageUp"
					},
					"when": {
						"all": ["kilo.work-sessions/workSessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "toggle-carousel",
					"title": "Toggle carousel",
					"category": "Tabs",
					"order": 40,
					"keybinding": {
						"mac": "Ctrl+Mod+C",
						"default": "Ctrl+Alt+C"
					},
					"when": {
						"all": ["kilo.work-sessions/workSessionActive"],
						"none": ["kernel/secondaryWindow"]
					}
				},
				{
					"id": "pane-1",
					"title": "Go to tab 1",
					"category": "Tabs",
					"order": 1,
					"palette": false,
					"keybinding": "Mod+1",
					"when": {
						"all": ["kilo.work-sessions/workSessionActive"],
