{
	"name": "@anaconda-desktop/app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Anaconda Agentic Desktop",
	"productName": "Anaconda Agentic Desktop",
	"author": "Anaconda, Inc.",
	"homepage": "https://github.com/anaconda/agentic-desktop",
	"repository": {
		"type": "git",
		"url": "https://github.com/anaconda/agentic-desktop.git"
	},
	"packageManager": "pnpm@11.17.0",
	"main": ".vite/build/main.js",
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p src/renderer/tsconfig.json && tsc --noEmit --project e2e/tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"make": "electron-forge make",
		"package": "electron-forge package",
		"prepublish": "tsx config/preflight-publish.ts",
		"publish": "electron-forge publish",
		"start": "electron-forge start -- --remote-debugging-port=9222",
		"test": "vitest run",
		"pretest:e2e": "pnpm run package",
		"test:e2e": "playwright test --config e2e/playwright.config.ts"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.1",
		"electron-debug": "^4.1.0",
		"electron-log": "^5.4.3",
		"electron-squirrel-startup": "^1.0.1",
		"electron-store": "^11.0.2",
		"execa": "^9.6.0",
		"react-use": "^17.6.1",
		"update-electron-app": "^3.3.0"
	},
	"devDependencies": {
		"@anaconda/shadcn-theme": "0.0.1-alpha.3",
		"@base-ui/react": "^1.6.0",
		"@electron-forge/cli": "8.0.0-alpha.10",
		"@electron-forge/maker-deb": "8.0.0-alpha.10",
		"@electron-forge/maker-dmg": "8.0.0-alpha.10",
		"@electron-forge/maker-rpm": "8.0.0-alpha.10",
		"@electron-forge/maker-squirrel": "8.0.0-alpha.10",
		"@electron-forge/maker-zip": "8.0.0-alpha.10",
		"@electron-forge/plugin-fuses": "8.0.0-alpha.10",
		"@electron-forge/plugin-vite": "8.0.0-alpha.10",
		"@electron-forge/publisher-s3": "8.0.0-alpha.10",
		"@electron-forge/shared-types": "8.0.0-alpha.10",
		"@electron/fuses": "^2.0.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/router-plugin": "^1.168.23",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/electron-squirrel-startup": "1.0.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"@vitest/browser": "5.0.0-beta.7",
		"@vitest/browser-playwright": "5.0.0-beta.7",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.4",
		"drizzle-orm": "^0.45.2",
		"electron": "43.2.0",
		"lucide-react": "^1.27.0",
		"playwright": "^1.61.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"shadcn": "^4.16.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	}
}
