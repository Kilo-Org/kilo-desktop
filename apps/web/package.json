		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"@vitest/browser": "5.0.0-beta.7",
		"@vitest/browser-playwright": "5.0.0-beta.7",
		"@vitest/coverage-v8": "5.0.0-beta.7",
		"playwright": "1.61.1",
		"shadcn": "^4.16.0",
		"tailwindcss": "^4.3.3",
