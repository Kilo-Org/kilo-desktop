{
	"name": "@anaconda-desktop/app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Anaconda Agentic Desktop",
	"productName": "Anaconda Agentic Desktop",
	"author": "Anaconda, Inc.",
	"packageManager": "pnpm@11.17.0",
	"main": ".vite/build/main.js",
	"scripts": {
		"postinstall": "svelte-kit sync",
		"build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
		"build:main": "vite build --config vite.main.config.ts",
		"build:preload": "vite build --config vite.preload.config.ts",
		"build:renderer": "vite build --config vite.renderer.config.ts",
		"check": "svelte-kit sync && tsc --noEmit -p tsconfig.main.json && tsc --noEmit --project e2e/tsconfig.json && svelte-check --tsconfig ./src/renderer/tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"package": "pnpm build && electron-builder --config ../electron-builder.config.js",
		"start": "electron-forge start",
		"test": "vitest run",
		"pretest:e2e": "pnpm build",
		"test:e2e": "playwright test --config e2e/playwright.config.ts"
	},
	"dependencies": {
		"@tanstack/svelte-query": "^6.1.38",
		"better-sqlite3": "^13.0.1",
		"drizzle-orm": "^0.45.2",
		"electron-debug": "^4.1.0",
		"electron-log": "^5.4.3",
		"electron-store": "^11.0.2",
		"electron-updater": "^6.6.2",
		"execa": "^9.6.0",
		"mode-watcher": "^1.1.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@electron-forge/cli": "8.0.0-alpha.10",
		"@electron-forge/plugin-vite": "8.0.0-alpha.10",
		"@electron-forge/shared-types": "8.0.0-alpha.10",
		"@electron/fuses": "^2.0.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.27.0",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^7.6.13",
		"@vitest/browser": "5.0.0-beta.7",
		"@vitest/browser-playwright": "5.0.0-beta.7",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.4",
		"electron": "43.2.0",
		"electron-builder": "^26.15.3",
		"playwright": "^1.61.1",
		"shadcn-svelte": "^1.4.2",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-toolbelt": "^0.10.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
